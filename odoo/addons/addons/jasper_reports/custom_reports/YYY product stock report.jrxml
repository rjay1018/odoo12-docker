	<variable name="sales_price" class="java.lang.Double">
		<variableExpression><![CDATA[Double.valueOf($F{Public_Price-lst_price} == "" ? 0.00 :$F{Public_Price-lst_price})]]></variableExpression>
	</variable>
	<variable name="Onhand" class="java.lang.Double">
		<variableExpression><![CDATA[Double.valueOf($F{Quantity_On_Hand-qty_available} == "" ? 0.00 :$F{Quantity_On_Hand-qty_available})]]></variableExpression>
	</variable>
	<variable name="total" class="java.lang.Double">
		<variableExpression><![CDATA[$V{sales_price} * $V{Onhand}]]></variableExpression>
	</variable>
