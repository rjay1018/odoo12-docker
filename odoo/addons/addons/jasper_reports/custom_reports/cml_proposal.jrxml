<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cml_proposal" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["/opt/odoo12/custom/addons/jasper_reports/custom_reports/"]]></defaultValueExpression>
	</parameter>
	<parameter name="coverletter" class="java.lang.Object">
		<defaultValueExpression><![CDATA["/opt/odoo12/custom/addons/jasper_reports/custom_reports/coverletter.jrxml"]]></defaultValueExpression>
	</parameter>
	<queryString language="xPath">
		<![CDATA[]]>
	</queryString>
	<field name="Order_Reference-name" class="java.lang.String">
		<fieldDescription><![CDATA[/data/record/Order_Reference-name]]></fieldDescription>
	</field>
	<background>
		<band/>
	</background>
	<title>
		<band height="61">
			<staticText>
				<reportElement x="0" y="0" width="148" height="51"/>
				<textElement lineSpacing="Single">
					<font size="25"/>
				</textElement>
				<text><![CDATA[Sales Order]]></text>
			</staticText>
		</band>
	</title>
	<detail>
		<band height="125">
			<subreport>
				<reportElement x="0" y="0" width="200" height="100"/>
				<dataSourceExpression><![CDATA[$P{coverletter}]]></dataSourceExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{SUBREPORT_DIR} + "coverletter.jasper"]]></subreportExpression>
			</subreport>
		</band>
	</detail>
</jasperReport>
