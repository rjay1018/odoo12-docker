				<textElement verticalAlignment="Middle" lineSpacing="Single" markup="html">
					<font size="8" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["5. In the event of late payment, supplier is entitled to "+"<b>"+"withhold further deliveries."+"</b>"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="81" y="90" width="411" height="15" forecolor="#000000" backcolor="#669900"/>
