				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["2. Make all checks payable to "+"<b>"+"[YYY Enterprises Inc.]"+"</b>"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="81" y="105" width="411" height="15" forecolor="#000000" backcolor="#669900"/>
				<textElement verticalAlignment="Middle" lineSpacing="Single" markup="html">
