				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["3. Payment must be according to "+"<b>"+"approved terms."+"</b>"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="81" y="120" width="411" height="15" forecolor="#000000" backcolor="#669900"/>
				<textElement verticalAlignment="Middle" lineSpacing="Single" markup="html">
					<font size="8" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["4. Overdue account shall bear an interest of "+"<b>"+"12% per annum."+"</b>"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="89" y="75" width="479" height="15" forecolor="#000000" backcolor="#669900"/>
				<textElement verticalAlignment="Middle" lineSpacing="Single" markup="html">
					<font size="8" isBold="false"/>
				</textElement>
