<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="seq_clinic_appointment" model="ir.sequence">
            <field name="name">Task Inventory</field>
            <field name="code">job.functions.sequence</field>
            <field name="prefix">JF</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_hr_emp_request" model="ir.sequence">
            <field name="name">HR: Employee Request - Reference #</field>
            <field name="code">hr.emp.req.ref.no</field>
            <field name="prefix">ER%(year)s%(month)s%(day)s-</field>
            <field name="padding">2</field>
        </record>

    </data>
</odoo>
