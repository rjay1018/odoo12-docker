<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="succession_plan_tree" model="ir.ui.view">
            <field name="name">succession.plan.tree</field>
            <field name="model">succession.plan</field>
            <field name="arch" type="xml">
                <tree string="Succession Planning" editable="top">
                    <field name="jobs_id"/>
                    <field name="candidate_id"/>
                    <field name="interim_successor"/>
                    <field name="candidate_since"/>
                    <field name="ranking"/>
                    <field name="readiness"/>
                </tree>
            </field>
        </record>

        <record id="action_succession_plan" model="ir.actions.act_window">
            <field name="name">Succession Planning</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">succession.plan</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_succession_plan"
            parent="hr_recruitment.menu_hr_recruitment_configuration"
            action="action_succession_plan"
            sequence="20"/>

    </data>
</odoo>
