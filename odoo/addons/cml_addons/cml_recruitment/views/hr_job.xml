<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_hr_job_form_extend" model="ir.ui.view">
            <field name="name">hr.job.form.extend</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='set_open']" position="after">
                    <button name="set_cancel" string="Cancel" states="recruit" type="object" groups="base.group_user"/>
                    <button name="set_hold" string="Hold" states="cancel" type="object" groups="base.group_user"/>
                    <button name="set_recruit" string="Start Recruitment" states="hold" type="object" class="oe_highlight" groups="base.group_user"/>

                </xpath>
                <field name="state" position="replace">
                    <field name="state" widget="statusbar" statusbar_visible="recruit,open,cancel,hold"/>
                </field>
                <field name="address_id" position="after">
                    <field name="address_group_id"/>
                </field>
                <field name="no_of_recruitment" position="before">
                    <field name="job_level_id"/>
                    <field name="job_category_id"/>
                </field>
                <field name="no_of_recruitment" position="after">
                    <field name="approved_headcount"/>
                </field>
                <field name="user_id" position="attributes">
                    <attribute name="string">Recruiter</attribute>
                </field>
                <field name="hr_responsible_id" position="after">
                    <field name="effective_date"/>
                    <field name="revision_no"/>
                    <field name="reference_no"/>
                    <field name="opening_date"/>
                    <field name="requestor" invisible="1"/>
                </field>
                <field name="no_of_recruitment" position="after">
                    <field name="reporting_to"/>
                    <field name="career_prog"/>
                </field>
                <xpath expr="//group[@name='offer']" position="attributes">
                    <attribute name="string">HR Reference</attribute>
                </xpath>
                <xpath expr="//group[@name='recruitment']" position="after">
                    <group string="Pre-Qualifications">
                        <field name="ed_level"/>
                        <field name="course"/>
                        <field name="cert_req"/>
                        <field name="yr_exp"/>
                        <field name="special_training"/>
                        <field name="shift_sched"/>
                        <field name="travel"/>
                        <field name="job_oversees"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='description']" position="after">                    
                    <separator string="Job Functions" colspan="4"/>
                    <field name="job_function_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="task_id"/>
                            <field name="result_area"/>
                            <field name="performance_indicator"/>
                            <field name="work_tools"/>
                            <field name="monitoring"/>
                        </tree>
                    </field>
                    <separator string="Competency Profile" colspan="4"/>
                    <field name="competency_ids">
                        <tree editable="top">
                            <field name="knowledge"/>
                            <field name="capability"/>
                            <field name="skill_level"/>
                            <field name="talent"/>
                            <field name="org_result"/>
                        </tree>
                    </field>
                    <separator string="Previous Incumbents" colspan="4"/>
                    <field name="contract_ids">
                        <tree create="false">
                            <field name="employee_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state"/>
                        </tree>
                    </field>
                    <separator string="Succession Planning" colspan="4"/>
                    <field name="succession_ids" >
                        <tree>
                            <field name="candidate_id"/>
                            <field name="job_title"/>
                            <field name="interim_successor"/>
                            <field name="candidate_since"/>
                            <field name="ranking"/>
                            <field name="readiness"/>
                            <field name="nbox_rating" widget="ninebox"/>
                        </tree>
                    </field>
                </xpath>
            </field>
        </record>


        <record id="view_hr_job_tree_extend" model="ir.ui.view">
            <field name="name">hr.job.tree.extend</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="job_level_id"/>
                    <field name="approved_headcount"/>
                </field>
                <field name="no_of_recruitment" position="attributes">
                    <attribute name="string">Expected New Employees</attribute>
                </field>
                <field name="no_of_employee" position="attributes">
                    <attribute name="string">Current Number of Employees</attribute>
                </field>
                <field name="expected_employees" position="attributes">
                    <attribute name="string">Approved Head Count</attribute>
                </field>
            </field>
        </record>

        <record id="hr_job_level_view_tree" model="ir.ui.view">
            <field name="name">hr.job.level tree</field>
            <field name="model">hr.job.level</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="hr_job_level_view_form" model="ir.ui.view">
            <field name="name">hr.job.level_form</field>
            <field name="model">hr.job.level</field>
            <field name="arch" type="xml">
                <form string="Department Type">
                    <sheet>
                        <group col="4">
                            <field name="name"/>
                            <field name="active"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_job_level_action" model="ir.actions.act_window">
            <field name="name">Job Levels</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.job.level</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                Click to add a Job Level.
                </p>
            </field>
        </record>


        <record id="hr_job_category_view_form" model="ir.ui.view">
            <field name="name">hr.job.category_form</field>
            <field name="model">hr.job.category</field>
            <field name="arch" type="xml">
                <form string="Department Type">
                    <sheet>
                        <group col="4">
                            <field name="name"/>
                            <field name="active"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_job_category_action" model="ir.actions.act_window">
            <field name="name">Job Category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.job.category</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                Click to add a Job Category.
                </p>
            </field>
        </record>

        <record id="hr_address_group_view_form" model="ir.ui.view">
            <field name="name">hr.address.group.form</field>
            <field name="model">hr.address.group</field>
            <field name="arch" type="xml">
                <form string="Department Type">
                    <sheet>
                        <group col="4">
                            <field name="name"/>
                            <field name="active"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_address_group_action" model="ir.actions.act_window">
            <field name="name">Address Group</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.address.group</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                Click to add a Access Group.
                </p>
            </field>
        </record>


<!-- MENU ITEMS -->
        <menuitem
            id="hr_job_category_menu"
            name="Job Category"
            parent="hr_recruitment.menu_hr_recruitment_configuration"
            action="hr_job_category_action"
            sequence="12"
            />

        <menuitem
            id="hr_job_level_menu"
            name="Job Levels"
            parent="hr_recruitment.menu_hr_recruitment_configuration"
            action="hr_job_level_action"
            sequence="11"
            />

        <menuitem
            id="hr_address_group_menu"
            name="Address Group"
            parent="hr_recruitment.menu_hr_recruitment_configuration"
            action="hr_address_group_action"
            sequence="10"
            />

    </data>
</odoo>
