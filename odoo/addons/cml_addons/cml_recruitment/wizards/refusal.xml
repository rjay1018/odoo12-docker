<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="refusal_form" model="ir.ui.view">
        <field name="name">refusal.wizard.form</field>
        <field name="model">refusal.wizard</field>
        <field name="arch" type="xml">
            <form string="Refusal Reason">
                <group>
                    <field name="refusal_reason_id"/>    
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn btn-sm btn-primary"/>
                    <button string="Cancel" class="btn btn-sm btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>