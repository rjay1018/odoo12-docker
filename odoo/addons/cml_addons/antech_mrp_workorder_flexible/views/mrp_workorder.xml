<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="form_mrp_workorder_flexible_inherit" model="ir.ui.view">
      <field name="name">view.mrp.workorder.flexible.form.inherit</field>
      <field name="model">mrp.workorder</field>
      <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
      <field name="arch" type="xml">
        <button name="button_scrap" position="attributes">
          <attribute name="invisible">1</attribute>
        </button>
        <button name="record_production" position="attributes">
          <attribute name="confirm">Make sure that Consumed Quantity is correct because after this operation you can not edit this document again! Are you sure to mark as done this workorder?</attribute>
        </button>
        <field name="active_move_line_ids" position="replace">
          <h4 attrs="{'invisible': [('raw_workorder_line_ids', '=', [])]}">Components</h4>
          <field name="raw_workorder_line_ids"
                 attrs="{'invisible': [('raw_workorder_line_ids', '=', [])], 'readonly': [('state', 'in', 'cancel', 'done')]}">
            <tree editable="bottom" create="0" delete="0">
              <field name="product_id" readonly="1" force_save="1"/>
              <field name="product_tracking" invisible="1"/>
              <field name="company_id" invisible="1"/>
<!--              <field name="lot_id" attrs="{'readonly': [('product_tracking', '=', 'none')]}"-->
<!--                     context="{'default_company_id': company_id, 'default_product_id': product_id, 'active_mo_id': parent.production_id}"/>-->
              <field name="lot_id" attrs="{'readonly': [('product_tracking', '=', 'none')]}"
                     context="{'default_product_id': product_id, 'active_mo_id': parent.production_id}"/>
              <field name="qty_to_consume" readonly="1"/>
              <field name="qty_reserved" readonly="1"/>
              <field name="qty_done" attrs="{'column_invisible': [('parent.state', 'not in', ('progress', 'done'))]}"/>
              <field name="product_uom_id" invisible="1"/>
              <field name="move_id" invisible="1"/>
            </tree>
          </field>
          <h4 attrs="{'invisible': [('finished_workorder_line_ids', '=', [])]}">Finished Products</h4>
          <field name="finished_workorder_line_ids"
                 attrs="{'invisible': [('finished_workorder_line_ids', '=', [])], 'readonly': [('state', 'in', 'cancel', 'done')]}">
            <tree editable="bottom" create="0" delete="0">
              <field name="product_id"/>
              <field name="product_tracking" invisible="1"/>
              <field name="company_id" invisible="1"/>
              <field name="lot_id" attrs="{'readonly': [('product_tracking', '=', 'none')]}"
                     context="{'default_company_id': company_id, 'default_product_id': product_id}"/>
              <field name="qty_to_consume" readonly="1" string="To Produce"/>
              <field name="qty_done" string="Produced"/>
              <field name="product_uom_id" invisible="1"/>
              <field name="move_id" invisible="1"/>
            </tree>
          </field>
        </field>
      </field>
    </record>

  </data>
</odoo>