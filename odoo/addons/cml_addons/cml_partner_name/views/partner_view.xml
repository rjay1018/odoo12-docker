<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_simple_form_firstname_extend" model="ir.ui.view">
        <field name="name">Add firstname and lastname</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_firstname.view_partner_simple_form_firstname"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='lastname']" position="after">
                    <field name="middlename" attrs=
                        "{'required': [('firstname', '=', False),
                        ('is_company', '=', False),
                        ('type', '=', 'contact')]}"/>
                </xpath>
            </data>
        </field>
    </record>

    <record id="view_partner_form_firstname_extend" model="ir.ui.view">
        <field name="name">Add firstname and surnames</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_firstname.view_partner_form_firstname"/>
        <field name="arch" type="xml">
            <data>

                <xpath expr="//field[@name='lastname']" position="after">
                    <field name="middlename" attrs=
                        "{'required': [('firstname', '=', False),
                        ('is_company', '=', False),
                        ('type', '=', 'contact')]}"/>
                </xpath>

                <xpath expr="//field[@name='child_ids']/form//field[@name='lastname']"
                    position="after">
                    <field name="middlename" attrs=
                        "{'required': [('firstname', '=', False),
                        ('is_company', '=', False),
                        ('type', '=', 'contact')]}"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>