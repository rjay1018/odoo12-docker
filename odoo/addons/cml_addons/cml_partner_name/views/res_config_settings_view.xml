<odoo>
    <data>
        <record model="ir.ui.view" id="res_config_settings_view_form_inherit">
            <field name="name">res.config.settings.view.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@data-key='hr']/div[1]" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="name_formula"/>
                            <field name="name_formula"/>
                            <div class="text-muted">
                                Select Formula for employee Name.
                            </div>
                            <button string="Recompute Names" 
                                type="object" 
                                name="action_recompute_name" 
                                class="oe_highlight"/>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>