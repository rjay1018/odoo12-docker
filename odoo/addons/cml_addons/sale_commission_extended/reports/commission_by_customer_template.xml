<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_commission_by_customer">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mt32 mb16">
                            <div class="col-6" t-if="o.agent">
                                <strong>Sales Agent:</strong>
                                <p t-field="o.agent"/>
                            </div>
                            <div class="col-6" t-if="o.date_from and o.date_to">
                                <strong>Period:</strong>
                                <p><span t-field="o.date_from"/> to <span t-field="o.date_to"/></p>
                            </div>
                        </div>

                        <h3>Commission Report by Customer</h3>

                        <t t-set="report_data" t-value="get_by_customer_data(o)"/>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Invoice #</th>
                                    <th>Date</th>
                                    <th>Product</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-right">Price</th>
                                    <th class="text-right">Total</th>
                                    <th class="text-right">Comm. Rate</th>
                                    <th class="text-right">Comm. Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="report_data['customers']" t-as="c">
                                    <tr class="bg-light">
                                        <td colspan="8"><strong><span t-esc="c['partner']"/></strong></td>
                                    </tr>
                                    <tr t-foreach="c['lines']" t-as="l">
                                        <td><span t-esc="l['invoice']"/></td>
                                        <td><span t-esc="l['invoice_date']"/></td>
                                        <td><span t-esc="l['product']"/></td>
                                        <td class="text-right"><span t-esc="'{:,.2f}'.format(l['quantity'])"/></td>
                                        <td class="text-right"><span t-esc="'{:,.2f}'.format(l['unit_price'])"/></td>
                                        <td class="text-right"><span t-esc="'{:,.2f}'.format(l['price_subtotal'])"/></td>
                                        <td class="text-right"><span t-esc="l['commission_rate']"/></td>
                                        <td class="text-right"><span t-esc="'{:,.2f}'.format(l['commission_amount'])"/></td>
                                    </tr>
                                    <tr class="font-weight-bold">
                                        <td colspan="5" class="text-right">Customer Subtotal:</td>
                                        <td class="text-right"><span t-esc="'{:,.2f}'.format(c['total_sales'])"/></td>
                                        <td/>
                                        <td class="text-right"><span t-esc="'{:,.2f}'.format(c['total_commission'])"/></td>
                                    </tr>
                                </t>

                                <tr class="font-weight-bold table-active">
                                    <td colspan="5" class="text-right">Grand Total:</td>
                                    <td class="text-right"><span t-esc="'{:,.2f}'.format(report_data['grand_total_sales'])"/></td>
                                    <td/>
                                    <td class="text-right"><span t-esc="'{:,.2f}'.format(report_data['grand_total_commission'])"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <report id="action_report_commission_by_customer"
        model="sale.commission.settlement"
        string="Commission Report by Customer"
        report_type="qweb-pdf"
        name="sale_commission_extended.report_commission_by_customer"
        file="sale_commission_extended.report_commission_by_customer"/>

    <record id="action_export_commission_by_customer_excel" model="ir.actions.server">
        <field name="name">Commission Report by Customer (Excel)</field>
        <field name="model_id" ref="sale_commission.model_sale_commission_settlement"/>
        <field name="binding_model_id" ref="sale_commission.model_sale_commission_settlement"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records[:1].action_export_excel_by_customer()
        </field>
    </record>

</odoo>
