<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="hr_overtime_rule_code_tree_view" model="ir.ui.view">
			<field name="name">hr.overtime.rule.code.tree</field>
			<field name="model">hr.overtime.rule.code</field>
			<field name="arch" type="xml">
				<tree string="Overtime Codes" editable="bottom">
					<field name="name" />
					<field name="rate" />
				</tree>
			</field>
		</record>
		
		<record model="ir.actions.act_window" id="action_hr_overtime_rule_codes">
			<field name="name">Overtime Codes</field>
			<field name="res_model">hr.overtime.rule.code</field>
			<field name="view_type">form</field>
			<field name="view_mode">tree,form</field>
		</record>

		<menuitem action="action_hr_overtime_rule_codes" name="Overtime Codes"
			id="hr_overtime_rule_code_menu" parent="hr_overtime_config_menu" sequence="11"
			groups="to_hr_overtime_payroll.group_hr_overtime_manager" />
	</data>
</odoo>