<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="view_hr_overtime_request_graph" model="ir.ui.view">
			<field name="name">hr.overtime.request.graph</field>
			<field name="model">hr.overtime.report</field>
			<field name="arch" type="xml">
				<graph string="Attendance">
					<field name="department_id" />
					<field name="worked_hours" type="measure" />
				</graph>
			</field>
		</record>

		<!-- calendar view -->
		<record model="ir.ui.view" id="view_hr_overtime_request_calendar">
			<field name="name">hr.overtime.request.calendar</field>
			<field name="model">hr.overtime.report</field>
			<field name="arch" type="xml">
				<calendar string="Overtime Calendar" date_start="start_time"
					date_stop="end_time" color="employee_id" mode="month" quick_add="False">
					<field name="employee_id" />
					<field name="overtime_rule_id" />
				</calendar>
			</field>
		</record>

		<record id="view_hr_overtime_request_pivot" model="ir.ui.view">
			<field name="name">hr.overtime.request.pivot</field>
			<field name="model">hr.overtime.report</field>
			<field name="arch" type="xml">
				<pivot string="Overtime">
					<field name="department_id" type="row" />
					<field name="end_time" type="col" />
					<field name="worked_hours" type="measure" />
				</pivot>
			</field>
		</record>

		<record model="ir.ui.view" id="overtime_report_search_view">
			<field name="name">hr.overtime.report.search</field>
			<field name="model">hr.overtime.report</field>
			<field name="arch" type="xml">
				<search>
					<field name="employee_id" />
					<field name="department_id" />
					<field name="job_id" />
					<field name="overtime_rule_id" />
					<filter name="my_request" string="My Request"
						domain="[('employee_id', '=', uid)]" />
					<separator />
					<filter name="to_approve_request" string="To Approve"
						domain="[('state', '=', 'confirmed')]" />
					<filter name="approved_request" string="Approved"
						domain="[('state', '=', 'approved')]" />
					<filter name="done_request" string="Reported in Payslip"
						domain="[('state', '=', 'done')]" />
					<separator />
					<filter string="Last Year" name="ftr_last_year" help="Show overtime data in the last year" domain="[('start_time','&gt;=',(context_today()-relativedelta(years=1)).strftime('%Y-01-01')),('end_time','&lt;',time.strftime('%Y-01-01'))]"/>
					<filter string="This Year" name="ftr_this_year" help="Show overtime data in the current year" domain="[('start_time','&gt;=',time.strftime('%Y-01-01'))]"/>
					<filter string="Last 30 Days" name="last_thirty_days"
						domain="[('start_time','&gt;=', ((context_today()-datetime.timedelta(days=30)).strftime('%Y-%m-%d'))), ('start_time','&lt;=',((context_today().strftime('%Y-%m-%d'))))]" />
					<group string="Group By">
						<filter name="group_by_employee" string="Employee"
							context="{'group_by': 'employee_id'}" />
						<filter name="group_by_department" string="Department"
							context="{'group_by': 'department_id'}" />
						<filter name="group_by_job" string="Job" context="{'group_by': 'job_id'}" />
						<filter name="group_by_overtime_rule_id" string="Overtime Rule"
							context="{'group_by': 'overtime_rule_id'}" />
					</group>
				</search>
			</field>
		</record>

		<record id="action_hr_overtime_request_graph" model="ir.actions.act_window">
			<field name="name">Overtime Analysis</field>
			<field name="res_model">hr.overtime.report</field>
			<field name="view_type">form</field>
			<field name="view_mode">pivot,graph,calendar</field>
			<field name="view_id"></field>  <!-- force empty -->
			<field name="context">{'search_default_approved_request':1,'search_default_done_request':1,'search_default_ftr_this_year':1}</field>
		</record>

		<menuitem name="Reports" parent="menu_hr_overtime_report_main"
			sequence="5" id="menu_hr_overtime_request_report" action="action_hr_overtime_request_graph"
			groups="to_hr_overtime_payroll.group_hr_overtime_user" />
	</data>
</odoo>