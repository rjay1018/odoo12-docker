<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="hr_overtime_line_tree_view" model="ir.ui.view">
			<field name="name">hr.overtime.line.tree</field>
			<field name="model">hr.overtime.line</field>
			<field name="arch" type="xml">
				<tree string="Overtime Rules" create="false" edit="false"
					delete="false">
					<field name="employee_id" />
					<field name="start_time" />
					<field name="end_time" />
					<field name="worked_hours" />
					<field name="reason_id" />
					<field name="hr_contract_id" />
					<field name="resource_calendar_id" />
					<field name="work_day_type_id"/>
					<field name="overtime_rule_id" />
					<field name="approved_by" />
					<field name="payslip_ot_line_id" />
					<field name="state" />
					<field name="approving_user_id" invisible="1" />
				</tree>
			</field>
		</record>

		<record id="hr_overtime_line_form_view" model="ir.ui.view">
			<field name="name">hr.overtime.line.form</field>
			<field name="model">hr.overtime.line</field>
			<field name="arch" type="xml">
				<form string="Overtime Lines" delete="false" create="false" edit="false">
					<header>
						<field name="state" widget="statusbar" statusbar_visible="draft,confirmed,approved" />
					</header>
					<sheet>
						<group>
							<group>
								<field name="employee_id" />
								<field name="department_id" />
								<field name="approved_by" />
								<label for="start_time" string="Hours" />
								<div>
									<field name="start_time" class="oe_inline" />
									-
									<field name="end_time" class="oe_inline" />
								</div>
								<field name="reason_id" />
								<field name="approving_user_id" invisible="1" />
							</group>
							<group>

								<field name="worked_hours" />
								<field name="hr_contract_id" />
								<field name="resource_calendar_id" />
								<field name="work_day_type_id"/>
								<field name="overtime_rule_id" />
								<field name="rate" />
								<field name="payslip_ot_line_id" />
								<field name="payslip_id" />
							</group>
						</group>
					</sheet>
				</form>
			</field>
		</record>

		<record model="ir.actions.act_window" id="action_hr_overtime_lines">
			<field name="name">Overtime Lines</field>
			<field name="res_model">hr.overtime.line</field>
			<field name="view_type">form</field>
			<field name="view_mode">tree,pivot,form</field>
		</record>

		<menuitem name="Overtime Lines" action="action_hr_overtime_lines"
			id="hr_overtime_line_menu" parent="menu_hr_overtime_report_main" sequence="10"
			groups="to_hr_overtime_payroll.group_hr_overtime_manager" />
	</data>
</odoo>