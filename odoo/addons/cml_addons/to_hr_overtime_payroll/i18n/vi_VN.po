msgstr "Bạn không thể huỷ khai báo tăng ca bắt đầu từ '%s' đến '%s' khi mà nó đang được sử dụng trong phiếu lương %s."

#. module: to_hr_overtime_payroll
#: code:addons/to_hr_overtime_payroll/models/hr_overtime_line.py:334
#, python-format
msgid "You cannot cancel the overtime interval specified by '%s' and '%s' and for the employee %s while its state is neither Confirmed nor Approved nor Refused."
msgstr "Bạn không thể huỷ khai báo tăng ca bắt đầu từ '%s' đến '%s' cho nhân viên %s khi mà trạng thái của nó không phải là Xác nhận hay Đã duyệt hay Bị từ chối."

