msgstr "Bạn không thể đặt khai báo tăng ca %s về trạng thái Hoàn thành khi mà nó không ở trạng thái 'Được duyệt'"

#. module: to_hr_overtime_payroll
#: code:addons/to_hr_overtime_payroll/models/hr_overtime_line.py:288
#, python-format
msgid "You cannot refuse a request line whose state is other than 'approved'"
msgstr "Không thể từ chối một yêu cầu mà trạng thái của yêu cầu này không phải 'Đã chấp thuận'"

#. module: to_hr_overtime_payroll
#: code:addons/to_hr_overtime_payroll/models/hr_overtime_line.py:291
#, python-format
msgid "You cannot refuse an overtime line while it is linked to a payslip"
msgstr "Bạn không thể từ chối một khai báo tăng ca mà đã có tính vào phiếu lương"

#. module: to_hr_overtime_payroll
#: code:addons/to_hr_overtime_payroll/models/hr_overtime_line.py:314
#, python-format
msgid "You cannot set the overtime interval specified by '%s' and '%s' for the employee %s to Draft state while it is not in Cancelled state"
msgstr "Bạn không thể thiết lập khai báo tăng ca từ '%s' đến '%s' đối với nhân viên %s về trạng thái Dự thảo khi mà nó không đang ở trạng thái Huỷ"

#. module: to_hr_overtime_payroll
#: code:addons/to_hr_overtime_payroll/models/hr_overtime_rule.py:77
