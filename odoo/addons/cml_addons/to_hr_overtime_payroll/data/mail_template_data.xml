<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--Email template -->
        <record id="email_template_overtime_request_confirm" model="mail.template">
            <field name="name">Overtime Request for Single- Send by Email</field>
            <field name="email_from">System</field>
            <field name="subject">Approve Overtime Request (Ref ${object.employee_id.name_related or 'n/a' })</field>
            <field name="partner_to">${object.approving_user_id.partner_id.id}</field>
            <field name="lang">${object.approving_user_id.partner_id.lang}</field>
            <field name="model_id" ref="to_hr_overtime_payroll.model_hr_overtime_request_single"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html"><![CDATA[
    <p>Dear ${object.approving_user_id.partner_id.name},</p>
    <p>There is an overtime request <strong>${object.name}</strong> from the employee: ${object.employee_id.name}.</p>
    <p>Please review and approve / refuse.</p>
    <p>Best Regard,</p>
            ]]></field>
        </record>

    </data>
</odoo>
