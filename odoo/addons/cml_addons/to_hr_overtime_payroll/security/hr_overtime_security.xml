<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_hr_overtime_user" model="res.groups">
        <field name="name">Officer</field>
        <field name="category_id" ref="to_hr_overtime_payroll.module_category_hr_overtime"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="comment">The user will have the right to approve overtime requests submitted by his subordinate. This group also inherits HR Officer group</field>
    </record>

    <record id="group_hr_overtime_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="to_hr_overtime_payroll.module_category_hr_overtime"/>
        <field name="implied_ids" eval="[(4,ref('hr.group_hr_manager')), (4,ref('to_hr_overtime_payroll.group_hr_overtime_user'))]"/>
        <field name="users" eval="[(4,ref('base.user_root')),(4, ref('base.user_admin'))]"/>
        <field name="comment">The user will have all rights to do anything within this application and the HR application as it also inherits HR Manager Group.</field>
    </record>
    
    <!-- Records Rules -->
	<data>
		<!-- EMPLOYEES -->
		<!-- hr_overtime_request_single -->
		<record model="ir.rule" id="property_rule_personal_overtime_request_single">
			<field name="name">Personal Overtime Request Single - Employee</field>
			<field name="model_id" ref="model_hr_overtime_request_single"></field>
			<field name="groups" eval="[(4,ref('base.group_user'))]"></field>
			<field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
			<field eval="1" name="perm_read" />
			<field eval="1" name="perm_write" />
			<field eval="1" name="perm_unlink" />
			<field eval="1" name="perm_create" />
		</record>
		
		<!-- hr_overtime_request_line_single -->		
		<record model="ir.rule" id="property_rule_personal_overtime_line">
			<field name="name">Personal Overtime Line - Employee</field>
			<field name="model_id" ref="model_hr_overtime_line"></field>
			<field name="groups" eval="[(4,ref('base.group_user'))]"></field>
			<field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
			<field eval="1" name="perm_read" />
			<field eval="1" name="perm_write" />
			<field eval="1" name="perm_unlink" />
			<field eval="1" name="perm_create" />
		</record>
		
		<!-- OFFICERS -->
		<!-- hr_overtime_request_single -->
		<record model="ir.rule" id="property_rule_officer_overtime_request_single">
			<field name="name">Overtime Request Single - Officer</field>
			<field name="model_id" ref="model_hr_overtime_request_single"></field>
			<field name="groups" eval="[(4,ref('to_hr_overtime_payroll.group_hr_overtime_user'))]"></field>
			<field name="domain_force">['|',('approving_user_id','=',user.id),('approving_user_id','=',False)]</field>
			<field eval="1" name="perm_read" />
			<field eval="1" name="perm_write" />
			<field eval="1" name="perm_unlink" />
			<field eval="1" name="perm_create" />
		</record>
		
		<!-- hr_overtime_request_line_single -->		
		<record model="ir.rule" id="property_rule_officer_overtime_line">
			<field name="name">Overtime Line - Officer</field>
			<field name="model_id" ref="model_hr_overtime_line"></field>
			<field name="groups" eval="[(4,ref('to_hr_overtime_payroll.group_hr_overtime_user'))]"></field>
			<field name="domain_force">[('approving_user_id','=',user.id)]</field>
			<field eval="1" name="perm_read" />
			<field eval="1" name="perm_write" />
			<field eval="1" name="perm_unlink" />
			<field eval="1" name="perm_create" />
		</record>
		
		<!-- MANAGER -->
		<!-- hr_overtime_request_single -->
		<record model="ir.rule" id="property_rule_manager_overtime_request_single">
			<field name="name">Overtime Request Single - Manager</field>
			<field name="model_id" ref="model_hr_overtime_request_single"></field>
			<field name="groups" eval="[(4,ref('to_hr_overtime_payroll.group_hr_overtime_manager'))]"></field>
			<field name="domain_force">[(1,'=',1)]</field>
			<field eval="1" name="perm_read" />
			<field eval="1" name="perm_write" />
			<field eval="1" name="perm_unlink" />
			<field eval="1" name="perm_create" />
		</record>
		
		<!-- hr_overtime_request_line_single -->
		
		<record model="ir.rule" id="property_rule_manager_overtime_line">
			<field name="name">Overtime Line - Manager</field>
			<field name="model_id" ref="model_hr_overtime_line"></field>
			<field name="groups" eval="[(4,ref('to_hr_overtime_payroll.group_hr_overtime_manager'))]"></field>
			<field name="domain_force">[(1,'=',1)]</field>
			<field eval="1" name="perm_read" />
			<field eval="1" name="perm_write" />
			<field eval="1" name="perm_unlink" />
			<field eval="1" name="perm_create" />
		</record>
		
	</data>
</odoo>