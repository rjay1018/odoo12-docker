<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_payslip_run_inherit_id" model="ir.ui.view">
            <field name="name">hr.payslip.run.form</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_download_excel" type="object"
                            string="Payroll Report-Details"
                            class="oe_highlight"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="payroll_reports_exel_view">
            <field name="name">Payroll Report</field>
            <field name="model">payroll.reports.exel</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="file_name" invisible="1"/>
                        <field name="excel_file" filename="file_name"/>
                    </group>
                    <footer>
                        <button name="cancel" special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
