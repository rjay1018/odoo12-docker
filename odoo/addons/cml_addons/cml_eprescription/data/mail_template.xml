<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <record id="send_eprescription_email" model="mail.template">
            <field name="name">E-Presciption: Send by email</field>
            <field name="model_id" ref="cml_eprescription.model_clinic_eprescription"/>
            <field name="email_from">${object.user_id.email |safe}</field>
            <field name="email_to">${object.partner_id.email}</field>
            <field name="subject">E-Prescription of (Ref ${object.partner_id.name})</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear ${object.partner_id.name}
                        <br /><br />
                        I'm sending to you a copy of E-Prescription. Please see attached file.
                        <br /><br />
                        Please note that this Prescription is valid only until ${object.valid_until}.
                        <br /><br />
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>