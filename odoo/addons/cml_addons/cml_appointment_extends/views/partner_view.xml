<odoo>
    <data>
        <record id="view_partner_form_firstname" model="ir.ui.view">
            <field name="name">Add firstname and surnames</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_id']" position="after">
                    <field name="insurance_agency_id"/>
                </xpath>
                 <xpath expr="//field[@name='vat']" position="after">
                    <field name="is_respondent" invisible="1"/>
                </xpath>
            </field>
        </record>

<!--        <record id="view_partner_inherit_is_respondent" model="ir.ui.view">-->
<!--            <field name="name">res.partner</field>-->
<!--            <field name="model">res.partner</field>-->
