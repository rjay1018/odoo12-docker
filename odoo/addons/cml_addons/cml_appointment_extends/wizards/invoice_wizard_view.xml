<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="multi_service_invoice_form_view" model="ir.ui.view">
        <field name="name">multi.service.invoice.form.view</field>
        <field name="model">multi.service.invoice</field>
        <field name="arch" type="xml">
            <form>
                <group>
                <group>
                    <button name="actin_apply_free_session" string="Apply Free Session" type="object"
                            class="oe_highlight" attrs="{'invisible':[('available_session','&lt;=',0)]}"/>
                </group>
                    <group>
                        <field name="available_session"/>
                    </group>
                </group>

                <field name="appoint_id" nolabel="1" invisible="1"/>
                <group>
                    <field name='multi_service_ids' nolabel="1" context="{'default_appoint_id': appoint_id}">
                        <tree editable="bottom" delete="false" create="false">
                            <field name="service_id" readonly="1"/>
                            <field name="qty_to_invoice"/>
                            <field name="unit_price" readonly="1"/>
                            <field name="total_price" sum="total_price" readonly="1"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="action_create_invoice" string="Create Invoice"
                        type="object" default_focus="1" class="oe_highlight"/>
                    or
                    <button string="Cancel" class="oe_link"
                        special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_multi_invoice"
        model="ir.actions.act_window">
        <field name="name">Multi Invoice</field>
        <field name="res_model">multi.service.invoice</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
