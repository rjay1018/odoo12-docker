<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="costing_price_pivot_view" model="ir.ui.view">
        <field name="name">costing_price_pivot_view</field>
        <field name="model">mrp.production</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <pivot string="Costing Price">
                <field name="date_planned_start"/>
                <field name="name" type="row"/>
                <field name="total_all_cost" type="measure"/>
                <field name="sales_price" type="measure"/>
                <field name="product_uom_id"/>
                <field name="profit" type="measure"/>
<!--                <field name="total_material_cost" string="New Total Material Cost"/>-->
                <field name="total_material_cost" string="Total Actual Material Cost"/>
                <field name="total_labour_cost"/>
                <field name="total_overhead_cost"/>
                <field name="total_actual_labour_cost"/>
                <field name="total_actual_overhead_cost"/>
                <field name="state" invisible="1"/>
                </pivot>
        </field>
    </record>

    <record model="ir.ui.view" id="costing_price_form_view">
        <field name="name">costing_price_form_view</field>
        <field name="model">mrp.production</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_planned_start"/>
                    <field name="name"/>
                    <field name="total_all_cost"/>
                    <field name="sales_price"/>
                    <field name="product_uom_id"/>
                    <field name="profit"/>
                    <field name="state" invisible="1"/>
                </group>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="costing_price_tree">
        <field name="name">costing_price_tree</field>
        <field name="model">mrp.production</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date_planned_start"/>
                <field name="name"/>
                <field name="total_all_cost"/>
                <field name="sales_price"/>
                <field name="product_uom_id"/>
                <field name="profit"/>
                <field name="state" invisible="1"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="costing_price_action">
        <field name="name">Costing Price</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">form,tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"> </p>
        </field>
    </record>

    <record id="costing_price_sdf_tree"
                model="ir.actions.act_window.view">
            <field name="act_window_id" ref="costing_price_action"/>
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="costing_price_tree"/>
        </record>

    <record id="costing_price_sdf_form"
                model="ir.actions.act_window.view">
            <field name="act_window_id" ref="costing_price_action"/>
            <field name="sequence" eval="1"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="costing_price_form_view"/>
        </record>

    <record id="costing_price_sdf_pivot"
                model="ir.actions.act_window.view">
            <field name="act_window_id" ref="costing_price_action"/>
            <field name="sequence" eval="1"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="costing_price_pivot_view"/>
        </record>

    <menuitem id="costing_report_menu"
              name="Costing Price"
              parent="mrp.menu_mrp_reporting"
              action="costing_price_action"/>
</odoo>
