<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_change_invoice_journal_wizard" model="ir.ui.view">
        <field name="name">change.invoice.journal.wizard.form</field>
        <field name="model">change.invoice.journal.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Journal">
                <group>
                    <field name="journal_id"/>
                    <field name="invoice_ids" invisible="1"/>
                </group>
                <footer>
                    <button name="apply_journal_change" type="object" class="btn btn-primary" string="Apply"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
