<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_consigments_search" model="ir.ui.view">
        <field name="name">stock.consigments.search</field>
        <field name="model">stock.consigments</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="In Process" name="in_process" domain="[('state','=','in_process')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <filter string="Cancel" name="cancel" domain="[('state','=','cancel')]"/>

                <group expand="0" string="Group By...">
                    <filter name="state" string="State" domain="[]" context="{'group_by':'state'}"/>
                </group>
                <group expand="0" string="Group By...">
                    <filter name="partner_id" string="Partner" domain="[]" context="{'group_by':'partner_id'}"/>
                </group>
                <group expand="0" string="Group By...">
                    <filter name="stock_location" string="Stock Location" domain="[]"
                            context="{'group_by':'stock_location'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_stock_consigments_tree" model="ir.ui.view">
        <field name="name">stock.consigments.tree</field>
        <field name="model">stock.consigments</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="stock_consigments_form" model="ir.ui.view">
        <field name="name">stock.consigments.form</field>
        <field name="model">stock.consigments</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" id="button_confirm" string="In Process" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"
                            type="object"/>
                    <button name="action_done" id="button_done" string="Mark As Done" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'in_process')]}"
                            type="object"/>
                    <button name="action_cancel" id="button_cancel" string="Cancel" class="btn-danger"
                            attrs="{'invisible': [('state', 'not in', ('draft', 'in_process','done'))]}"
                            type="object"/>
                    <button name="create_invoice" string="Create Invoice" class="btn-primary"
                            attrs="{'invisible': ['|', ('invoice_count', '!=', 0), ('state', '!=', 'done'),]}"
                            type="object"
                            confirm="are you sure you want to create invoice"/>
                    <button name="action_recompute_invoice" string="Recompute Invoice" class="btn-secondary"
                            attrs="{'invisible': [('invoice_count', '=', 0)]}"
                            type="object"
                            confirm="This will rebuild linked draft invoices from the current consignment lines. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_stock_move"
                                class="oe_stat_button"
                                icon="fa-list"
                                type="object"
                                attrs="{'invisible': [('stock_move_count', '=', 0)]}">
                            <field name="stock_move_count" widget="statinfo"/>
                        </button>
                        <button name="action_open_sale_order"
                                class="oe_stat_button"
                                icon="fa-list"
                                type="object"
                                attrs="{'invisible': [('sale_order_count', '=', 0)]}">
                            <field name="sale_order_count" widget="statinfo"/>
                        </button>
                        <button name="invoice_smart_button"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                type="object"
                                attrs="{'invisible': [('invoice_count', '=', 0)]}">
                            <field name="invoice_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="stock_location" domain="[('usage', '=', 'internal')]"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="partner_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="start_date" attrs="{'readonly': [('state', '!=', 'draft')]}" invisible="1"/>
                            <field name="end_date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="user"/>
                            <field name="company_id"/>
                            <!--                            <field name="invoice_ids" invisible="1" widget="many2many_tags"/>-->
                            <field name="acc_invoice_ids" invisible="1" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Consignments" name="Consignment">
                            <field name="consignments_ids" attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}">
                                <tree editable="top" create="false" delete="false">
                                    <field name="product_id"/>
                                    <field name="move_ids" widget="many2many_tags" invisible="1"/>
                                    <field name="sale_order_line_ids" widget="many2many_tags" invisible="1"/>
                                    <field name="quantity"/>
                                    <field name="sold_quantity"/>
                                    <field name="product_uom"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_Consignments" model="ir.actions.act_window">
        <field name="name">Consignments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.consigments</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}
        </field>
    </record>

    <menuitem id="menu_consignments"
              name="Consignments"
              parent="stock.menu_stock_root"
              action="action_Consignments"
              sequence="10"/>
</odoo>