<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="inherit_view_order_form_route" model="ir.ui.view">
        <field name="name">sale order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="route_id" domain="[('show_on_customer', '=', True)]"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="context">{'default_route_id':route_id}</attribute>
            </xpath>
        </field>
    </record>

    <record id="inherit_view_partner_form_route" model="ir.ui.view">
        <field name="name">res partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_stock_supplier']" position="after">
                <field name="route_id" domain="[('show_on_customer', '=', True), ('sale_selectable', '=', False)]"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='mobile']" position="after">
                <field name="route_id" domain="[('show_on_customer', '=', True)]"
                       attrs="{'invisible': [('type', '!=', 'delivery')]}"/>
            </xpath>
        </field>
    </record>

    <record id="inherit_stock_location_route_form_view_route" model="ir.ui.view">
        <field name="name">stock location route</field>
        <field name="model">stock.location.route</field>
        <field name="inherit_id" ref="stock.stock_location_route_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_selectable']" position="after">
                <field name="show_on_customer" attrs="{'invisible': [('sale_selectable', '=', False)]}"/>
            </xpath>
        </field>
    </record>

</odoo>