<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_consignment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="address">
                            <div t-field="o.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>:
                                <span t-field="o.partner_id.vat"/>
                            </p>
                        </t>
                        <h2>
                            <t>
                                <span>Consignment #</span>
                            </t>
                            <span t-field="o.name"/>
                        </h2>
                        <div class="row mt32 mb16">
                            <div t-if="o.partner_id" class="col-3">
                                <strong>Partner:</strong>
                                <p class="m-0" t-field="o.partner_id"/>
                            </div>
                            <div t-if="o.stock_location" class="col-3">
                                <strong>Stock Location:</strong>
                                <p class="m-0" t-field="o.stock_location"/>
                            </div>

                            <div t-if="o.partner_id" class="col-3">
                                <strong>User:</strong>
                                <p class="m-0" t-field="o.user"/>
                            </div>
                            <div t-if="o.partner_id" class="col-3">
                                <strong>Company:</strong>
                                <p class="m-0" t-field="o.company_id.name"/>
                            </div>
                        </div>

                        <div class="row mb64">
<!--                             <div t-if="o.start_date" class="col-3">
                                <strong>Start Date:</strong>
                                <p class="m-0" t-field="o.start_date"/>
                            </div> -->
                            <div t-if="o.end_date" class="col-3">
                                <strong>To Date:</strong>
                                <p class="m-0" t-field="o.end_date"/>
                            </div>
                            <div t-if="o.date" class="col-3">
                                <strong>Create Date:</strong>
                                <p class="m-0" t-field="o.date"/>
                            </div>
                        </div>

                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th class="text-left">Product</th>
                                    <th class="text-right">Quantity</th>
                                    <th class="text-right">Sold Quantity</th>
                                    <th class="text-left">Unit Of Measure</th>
                                </tr>
                            </thead>
                            <tbody class="sale_tbody">
                                <t t-foreach="o.consignments_ids" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-field="line.product_id.name"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="line.sold_quantity"/>
                                        </td>
                                        <td>
                                            <span t-field="line.product_uom.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="paperformat_consignment_details" model="report.paperformat">
        <field name="name">Consignment Details Report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>


    <report
            id="action_report_consignment"
            string="Consignment"
            model="stock.consigments"
            report_type="qweb-pdf"
            file="ki_sales_consignment.report_consignment"
            name="ki_sales_consignment.report_consignment"
            print_report_name="'%s' % (object.name)"
            paperformat="ki_sales_consignment.paperformat_consignment_details"/>

</odoo>