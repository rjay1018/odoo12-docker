<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Category-->
    <record model="ir.module.category" id="module_category_helpline">
        <field name="name">Helpline</field>
        <field name="description">Category For Helpline</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_helpline_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="category_id" ref="module_category_helpline"/>
    </record>

    <record id="group_helpline_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="module_category_helpline"/>
    </record>
    
    <record id="group_helpline_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="category_id" ref="module_category_helpline"/>
        <field name="implied_ids" eval="[(4, ref('group_helpline_agent'))]"/>
    </record>

    <record id="group_helpline_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_helpline"/>
        <field name="implied_ids" eval="[(4, ref('group_helpline_agent'))]"/>
    </record>

    <!--Record Rules-->
    <!--Calls Rules-->

    <record model="ir.rule" id="sessions_record_rule">
        <field name="name">See Own Calls</field>
        <field name="model_id" ref="model_helpline_sessions"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_helpline_agent'))]"/>
    </record>
    

    <record model="ir.rule" id="sessions_staff_record_rule">
        <field name="name">See All Calls</field>
        <field name="model_id" ref="model_helpline_sessions"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_helpline_staff'))]"/>
    </record> 

    <record model="ir.rule" id="sessions_staff_record_rule">
        <field name="name">See All Calls</field>
        <field name="model_id" ref="model_helpline_sessions"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_helpline_supervisor'))]"/>
    </record> 

    <record model="ir.rule" id="sessions_mngr_record_rule">
        <field name="name">See All Calls</field>
        <field name="model_id" ref="model_helpline_sessions"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_helpline_manager'))]"/>
    </record>    

</odoo>
