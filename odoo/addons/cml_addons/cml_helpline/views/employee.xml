<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Form view for "hr.employee" -->
        <record id="hr_employee_agent_form" model="ir.ui.view">
            <field name="name">view.hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="cml_clinic.view_hr_specialist_form" />
            <field name="arch" type="xml">

				<xpath expr="//field[@name='extension']" position="attributes"> 
					<attribute name="invisible">True</attribute>
				</xpath>
				<xpath expr="//field[@name='is_specialist']" position="attributes"> 
					<attribute name="invisible">True</attribute>
				</xpath>
                <xpath expr="//field[@name='notes']" position="before">
                    <group string="Helpline Info">
                        <group>
                            <field name="is_specialist" string="Clinic Specialist"/>
                            <field name="helpline_agent"/>
                            <field name="extension"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>