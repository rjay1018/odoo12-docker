<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Menu Item for BIR Report Template -->


    <!-- Action for BIR Report Template -->
    <record id="action_bir_report_template" model="ir.actions.act_window">
        <field name="name">BIR Report Template</field>
        <field name="res_model">bir.report.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Tree View -->
    <record id="view_bir_report_template_tree" model="ir.ui.view">
        <field name="name">bir.report.template.tree</field>
        <field name="model">bir.report.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="filename"/>
                <field name="type"/>
                <field name="company_profile_name"/>
                <field name="company_position_name"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bir_report_template_form" model="ir.ui.view">
        <field name="name">bir.report.template.form</field>
        <field name="model">bir.report.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type" widget="selection"/>
                        <field name="file" filename="filename" widget="binary"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="company_profile_name"/>
                        <field name="company_position_name"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_bir_report_template"
              name="BIR Report Template"
              parent="account.menu_finance_entries"
              action="action_bir_report_template"
    />
</odoo>
