<odoo>
    <data>
        <record id="product_temp_from_view_inherit" model="ir.ui.view">
            <field name="name">product.temp.from.view.inherit</field>
            <field name="model">product.template</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[last()]" position="after">
                    <page string = "Allowed UOMs">
                        <field name="uom_category_id" invisible="1"/>
                        <field name="uom_ids" nolabel="1" domain="[('category_id','=',uom_category_id)]"/>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>