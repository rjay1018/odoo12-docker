<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Record rule: Restricted users can only read journals that are
            whitelisted in their personal user_id.journal_ids field.

            How it works:
              - The domain reads the journal IDs assigned specifically to 
                the current active user (via user_journal_restricted_rel).
              - Only journals in that list are returned.
              - This rule applies ONLY to the "Restricted Journal Access" group, 
                so all other users are unaffected (no rule = no restriction).

            To configure: Settings > Users > Open User > Check 'Restricted Journal Access'
            Then go to 'Journal Access' tab and pick journals.
        -->
        <record id="rule_journal_restricted_user" model="ir.rule">
            <field name="name">Restricted Users: Allowed Journals Only</field>
            <field name="model_id" ref="account.model_account_journal"/>
            <field name="domain_force">
                [('id', 'in', user.journal_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('qx_journal_access.group_restrict_journal_access'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
