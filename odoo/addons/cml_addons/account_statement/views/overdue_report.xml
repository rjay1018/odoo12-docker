<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<template id="bi_report_overdue_report">
			<t t-call="web.external_layout">
				<t t-set="doc" t-value="doc.with_context({'lang':doc.lang})" />
				<div class="text-right" style="margin-right: 15em;">
							<p><span t-esc="doc.name" /><br/>

							

						
						
							<span t-esc="doc.street" /><br/>
							<span t-esc="doc.street2" /><br/>
							<span t-esc="doc.city" />
							<span t-esc="doc.state_id.name" />
							<span t-esc="doc.zip" /><br/>
							<span t-esc="doc.country_id.name" />
						</p>
						<br/>
					</div>
					<div class="page">
						<div class="text-left">
							<span>Customer account statement</span><br/>
							<span>Date : </span><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')" /><br/>
							<br/>
							<span>Dear Sir/Madam,</span><br/>
							<br/>
							<span>Some payments on your account are still due. Please find details below.</span><br/>
							<br/>
							<span>Thank you.</span><br/>
							<span>Best Regards,</span><br/>
						</div>
						<t t-if="doc.balance_invoice_ids.ids">
                    <table class="table table-condensed" >
                        <thead>
                            <tr>
                                <th>Reference number</th>
                                <th class="text-center">Date</th>
                                <th class="text-center">Due Date</th>
                                <th class="text-right">Total</th>
                                <th class="text-right">Due</th>
                                <th class="text-right">Paid</th>
                            </tr>
                        </thead>
                        <t t-set="due_total" t-value="0"/>
                        <t t-set="paid_total" t-value="0"/>
                        <t t-set="total" t-value="0"/>
                        <tr t-foreach="doc.balance_invoice_ids" t-as="line">
                            <t t-if ="line.date_due">
                            <t t-if="datetime.date.today() > line.date_due  ">
                            	<t t-if="line.state !='paid' ">
                            
		                    <td>
		                        <span t-esc="line.number"/>
		                    </td>
		                    <td>
		                        <span t-esc="line.date_invoice"/>
		                    </td>
		                    <td>
		                        <span t-esc="line.date_due"/>
		                    </td>
		                    <td class="text-right">
		                        <span t-esc="line.amount_total_signed" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
		                    </td>
		                    <td class="text-right">
		                        <span t-esc="line.residual_signed" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
		                    </td>
		                    <td class="text-right">
		                            <span t-esc="line.amount_total_signed - line.residual_signed" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
		                    </td>
		                    <t t-set="due_total" t-value="due_total + line.amount_total_signed"/>
	                            <t t-set="paid_total" t-value="paid_total + (line.amount_total_signed - line.residual_signed)"/>
	                            <t t-set="total" t-value="total + line.residual_signed"/>
		                  </t>
                           </t>
                      </t>
                        </tr>
                        <tr>
                            <td></td>
			    <td></td>
                            <td><strong>Sub-Total :</strong></td>
                            <td class="text-right"><span t-esc="due_total" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                            <td class="text-right"><span t-esc="total" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                            <td class="text-right"><span t-esc="paid_total" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                        </tr>
                        <tr>
                            <td></td>
		    	    <td></td>
                            <td><strong>Balance :</strong></td>
                            <td class="text-right"><span t-esc="due_total" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                            <td class="text-right"><span t-esc="total" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                            <td class="text-right"><span t-esc="paid_total" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                         </tr>
                        </table>
                </t>
					</div>



            
       
        </t>
				
			
		</template>

		<template id="bi_report_overdue_due">
			<t t-call="web.html_container">
				<t t-foreach="docs" t-as="doc">
					<t t-call="account_statement.bi_report_overdue_report" t-lang="doc.lang" />
				</t>
			</t>
		</template>
	</data>
</odoo>


