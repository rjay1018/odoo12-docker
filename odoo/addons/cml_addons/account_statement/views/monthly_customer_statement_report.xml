<?xml version="1.0" encoding="utf-8"?>
<openerp>
	<data>
		<template id="report_customer_monthly_statement">
			<t t-call="web.external_layout">
				<t t-set="doc" t-value="doc.with_context({'lang':doc.lang})" />
				<div class="page">
					<div><br/><br/><br/><br/></div>
					<div class="oe_structure" />
					
						
						<h2>
							Monthly Customer Statement:
							<span t-esc="doc.name" />

						</h2>
<br/><br/>
						<h5>
							Month:  <span t-esc="doc.month_name" />

						</h5>
<div class="row">
						<t t-set="i" t-value="0.0" />
						<t t-set="j" t-value="0.0" />
						<t t-set="k" t-value="0.0" />
						<t t-foreach="doc.monthly_statement_line_ids" t-as="line">
<!-- 							<t t-if="line.account_id.internal_type=='payable'"> -->
								<!-- <t t-set="i" t-value="i+ line.amount_total" />
								<t t-set="j" t-value="j+line.credit_amount" />
								<t t-set="k" t-value="k+line.result" /> -->
<!-- 							</t> -->
						</t>
						</div>
						<br/><br/>
						<div class="row">
							<t t-if ="doc.monthly_statement_line_ids.ids">
						<table class="table table-condensed">
							<thead>
								<tr class="text-center">
									<th>Date</th>
									<th>Invoice Number</th>
									<th>Ref</th>
									<th>Invoices/Credit</th>
									<th>Payments/Debit</th>
									<th>Balance</th>
								</tr>
							</thead>

							<tbody>
								<tr t-foreach="doc.monthly_statement_line_ids" t-as="line">
<!-- 									<t t-if="line.account_id.internal_type=='payable'"> -->
										<td>
											<span t-esc="line.date_invoice" />
										</td>
										<td>
											<span t-esc="line.number" />
										</td>
										<td>
											<span t-esc="line.name" />
										</td>
										<td class="text-right">
											
											<span t-esc="line.amount_total"
												t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" />
										</td>
										<td class="text-right">
											<span t-esc="line.credit_amount"
												t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" />
										</td>
										<td class="text-right">
											
											<!-- <span t-esc="line.result"
												t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" /> -->
											<t t-set="sub_total" t-value="line.amount_total-line.credit_amount" />
                                         	<t t-set="grand_total" t-value="sub_total + line.result"/>
											<span t-esc="sub_total"
												t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" />
										</td>
								</tr>
							</tbody>

						</table>
					</t>
					</div>
						<div >
							
								<table class="table table-condensed">
									<tr class="border-black">
										<td>
											<strong>Total Amount OverDue :</strong>
										</td>
										<td class="text-right">
											<span t-field="doc.monthly_payment_amount_overdue_amt"
												t-options='{"widget": "monetary", "display_currency": res_company.currency_id}' />
										</td>
									</tr>
									<tr class="border-black">
										<td>
											<strong>Balance Due :</strong>
										</td>
										<td class="text-right">
											<span t-field="doc.monthly_payment_amount_due_amt"
												t-options='{"widget": "monetary", "display_currency": res_company.currency_id}' />
										</td>
									</tr>
								</table>
							
						</div>

					
				</div>
			</t>
		</template>

		<template id="monthly_customer_statement">
			<t t-call="web.html_container">
				<t t-foreach="docs" t-as="doc">
					<t t-call="account_statement.report_customer_monthly_statement" t-lang="doc.lang" />
				</t>
			</t>
		</template>
	</data>
</openerp>
