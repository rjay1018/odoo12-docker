<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cml_stock_picking_costing" model="ir.ui.view">
        <field name="name">stock.picking.costing.view.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="show_expect_qty"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom']" position="after">
                <field name="product_expected_qty" string="Expected Qty" attrs="{'column_invisible': [('parent.show_expect_qty','=',False)]}"/>
                <field name="product_expected_uom_id" options="{'no_create': True}" string="Product Unit of Measure" groups="uom.group_uom" attrs="{'column_invisible': [('parent.show_expect_qty','=',False)]}"/>
            </xpath>
        </field>
    </record>
    
</odoo>