<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cml_stock_move_line_costing" model="ir.ui.view">
        <field name="name">stock.move.line.costing.view.form</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>

        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="before">

                <label for="product_uom_qty" string="Expected Qty"/>
                <div class="o_row">
                    <field name="product_expected_qty" string="Expected Qty"/>
                    <field name="product_expected_uom_id" options="{'no_create': True}" string="Product Unit of Measure" groups="uom.group_uom"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
