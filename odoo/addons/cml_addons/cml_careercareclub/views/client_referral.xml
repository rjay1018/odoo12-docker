<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <!-- Inherit Form View -->
    <record id="view_client_referrals_form_extend" model="ir.ui.view">
        <field name="name">view_client_referrals_form_extend</field>
        <field name="model">client.referral</field>
        <field name="inherit_id" ref="cml_clinic.view_client_referrals_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Reference ID</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Responsible</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Member</attribute>
            </xpath>
            <xpath expr="//field[@name='reason']" position="attributes">
                <attribute name="string">Narrative</attribute>
            </xpath>
		</field>
    </record>

    <!-- Inherit Tree View -->
    <record id="view_client_referrals_tree_extend" model="ir.ui.view">
        <field name="name">view_client_referrals_tree_extend</field>
        <field name="model">client.referral</field>
        <field name="inherit_id" ref="cml_clinic.view_client_referrals_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Reference ID</attribute>
            </xpath>
            <xpath expr="//field[@name='requested_date']" position="after">
                <field name="reason" string="Narrative"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Responsible</attribute>
            </xpath>
            <xpath expr="//field[@name='source']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit Action -->
    <record id="cml_clinic.client_referrals_action" model="ir.actions.act_window">
            <field name="name">Incident Report</field>
    </record>

    <!-- Inherit Menus -->
    <record id="cml_clinic.menu_client_referrals" model="ir.ui.menu">
        <field name="name">Incident Report</field>
    </record>
</odoo>
