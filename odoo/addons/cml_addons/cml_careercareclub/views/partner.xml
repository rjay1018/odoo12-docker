<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <!-- Inherit Form View -->
    <record id="view_clinic_client_form_extend" model="ir.ui.view">
        <field name="name">view_clinic_client_form_extend</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="cml_clinic.view_clinic_client_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_client']" position="attributes">
                <attribute name="string">Is a Member</attribute>
            </xpath>
            <xpath expr="//page[@name='personal_information_page']" position="attributes">
                <attribute name="string">Members Informations</attribute>
            </xpath>
            <xpath expr="//field[@name='source_id']" position="attributes">
                <attribute name="string">Level/Section or Department</attribute>
            </xpath>
            <xpath expr="//page[@name='client_case_file']/separator[3]" position="attributes">
                <attribute name="string">Incident Report</attribute>
            </xpath>
            <xpath expr="//page[@name='client_case_file']/separator[4]" position="attributes">
                <attribute name="string">Members File Record</attribute>
            </xpath>
		</field>
    </record>

