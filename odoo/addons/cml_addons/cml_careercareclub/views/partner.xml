    <record id="cml_clinic.action_client_partner" model="ir.actions.act_window">
            <field name="name">Members Information</field>
    </record>

    <!-- Inherit Menus -->
    <record id="cml_clinic.clinic_root" model="ir.ui.menu">
        <field name="name">Community</field>
    </record>
    <record id="cml_clinic.clinic_client" model="ir.ui.menu">
