<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="OfficialReceiptNumber_form" model="ir.ui.view">
            <field name="name">OfficialReceiptNumber.form</field>
            <field name="model">account.register.payments</field>
            <field name="inherit_id" ref="account.view_account_payment_from_invoices" />
            <field name="arch" type="xml">
                <xpath expr="//group" position="after">
                    <group>
                            <group string="Cheque Details" attrs="{'invisible': [('payment_type','=', 'outbound')]}">
                                <field name="cheque_no"/>
                                <field name="bank_id"/>
                                <field name="cheque_date"/>
                            </group>
                            <group string="Receipt Details">
                                <field name="official_receipt_no"/>
                            </group>
                        </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
