<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="AccountPaymentLocalization" model="ir.ui.view">
            <field name="name">AccountPaymentLocalization.form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_invoice_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="after">
                    <group>
                            <group string="Cheque Details">
                                <field name="cheque_no"/>
                                <field name="bank_id"/>
                                <field name="cheque_date"/>
                                <field name="passbook"/>
                            </group>
                            <group string="Receipt Details">
                                <field name="official_receipt_no"/>
                            </group>
                        </group>
                </xpath>
            </field>
        </record>

        <record id="OfficialReceipt" model="ir.ui.view">
              <field name="name">OfficialReceipt.form</field>
              <field name="model">account.payment</field>
              <field name="inherit_id" ref="account.view_account_payment_form"/>
              <field name="arch" type="xml">
                <xpath expr="//group" position="after">
                    <group>
                            <group string="Cheque Details">
                                <field name="cheque_no"/>
                                <field name="bank_id"/>
                                <field name="cheque_date"/>
                                <field name="passbook"/>
                            </group>
                            <group string="Receipt Details">
                                <field name="official_receipt_no"/>
                            </group>
                        </group>
                </xpath>
              </field>
        </record>


        <record id="OfficialReceiptSearch" model="ir.ui.view">
              <field name="name">OfficialReceipt.search</field>
              <field name="model">account.payment</field>
              <field name="inherit_id" ref="account.view_account_payment_search"/>
              <field name="arch" type="xml">
                    <field name="name" position="after">
                        <field name="amount" filter_domain="[('amount','ilike',self)]" string="Amount"/>
                        <filter string="Passbook is Checked" name="passbook" domain="[('passbook','=',True)]"/>
                    </field>
                    <field name="partner_id" position="before">
                        <field name="official_receipt_no"/>
                        <field name="cheque_no"/>
                  </field>
              </field>
        </record>

    </data>
</odoo>