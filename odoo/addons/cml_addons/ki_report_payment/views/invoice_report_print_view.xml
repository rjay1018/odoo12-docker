<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="ki_report_payment_inherit_print_report" model="ir.ui.view">
        <field name="name">ki.report.payment.inherit.print.report</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button type="action" name="%(ki_report_payment.action_print_invoice_report)d"
                        string="Print Report"
                        class="oe_highlight"/>
            </xpath>

            <xpath expr="//field[@name='payment_date']" position="after">
                <field name="report_ids" widget="many2many_tags" invisible="1"/>
            </xpath>

        </field>
    </record>

</odoo>
