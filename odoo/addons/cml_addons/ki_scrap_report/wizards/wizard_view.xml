<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model='ir.ui.view' id='scrap_wizard_form'>
            <field name="name">scrap.report.wizard.form</field>
            <field name="model">scrap.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Report Data">
                    <group>
                        <group>
                            <field name="start_date"/>
                            </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <footer>
                        <button name="export_xls" type="object" default_focus="1"
                                string="Generate Report" class="oe_highlight"
                                context="{'xls_export':1}" icon="fa-download"/>
                        or
                        <button string="Cancel" class="oe_link"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model='ir.actions.act_window' id='scrap_wizard_action'>
            <field name="name">Scrap in Excel</field>
            <field name="res_model">scrap.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="scrap_wizard_form"/>
            <field name="target">new</field>
        </record>

        <record model="ir.ui.view" id="scrap_report_template_excel_report_views">
            <field name="name">Scrap Report</field>
            <field name="model">scrap.reports.exel</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="file_name" invisible="1"/>
                        <field name="excel_file" filename="file_name"/>
                    </group>
                    <footer>
                        <button name="cancel" special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <menuitem name="Scrap Reporting"
                  id="export_product_card_excel" action="scrap_wizard_action"
                  sequence="160" parent="stock.menu_warehouse_report"/>
    </data>
</odoo>