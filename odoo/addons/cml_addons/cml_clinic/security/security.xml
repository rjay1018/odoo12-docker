    <record model="ir.rule" id="appointment_nurse_record_rule">
        <field name="name">See All Appointment</field>
        <field name="model_id" ref="model_clinic_appointment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_clinic_nurse'))]"/>
    </record> 

    <record model="ir.rule" id="appointment_nurse_record_rule">
        <field name="name">See All Appointment</field>
        <field name="model_id" ref="model_clinic_appointment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_clinic_supervisor'))]"/>
    </record> 


    <record model="ir.rule" id="appointment_mngr_record_rule">
        <field name="name">See All Appointment</field>
        <field name="model_id" ref="model_clinic_appointment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_clinic_manager'))]"/>
    </record> 

    <!--Specialist Profile Rules-->
    <record model="ir.rule" id="profile_record_rule">
        <field name="name">See Own Profile</field>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_clinic_specialist'))]"/>
    </record>

    <record model="ir.rule" id="profile_mngr_record_rule">
        <field name="name">See All Profile</field>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_clinic_manager'))]"/>
    </record>

    <!-- Client Own Profile -->


    <record model="ir.rule" id="client_profile">
        <field name="name">See Own Profile</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="domain_force">[('id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_clinic_client'))]"/>
    </record>

