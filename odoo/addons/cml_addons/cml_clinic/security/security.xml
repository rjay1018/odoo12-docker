<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Category-->
    <record model="ir.module.category" id="module_category_clinic">
        <field name="name">Clinic</field>
        <field name="description">Category For Clinic</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_clinic_specialist" model="res.groups">
        <field name="name">Specialist</field>
        <field name="category_id" ref="module_category_clinic"/>
    </record>
    
    <record id="group_clinic_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="category_id" ref="module_category_clinic"/>
        <field name="implied_ids" eval="[(4, ref('group_clinic_specialist'))]"/>
    </record>

    <record id="group_clinic_nurse" model="res.groups">
        <field name="name">Staff</field>
        <field name="category_id" ref="module_category_clinic"/>
    </record>

    <record id="group_clinic_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_clinic"/>
        <field name="implied_ids" eval="[(4, ref('group_clinic_specialist'))]"/>
    </record>

    <record id="group_clinic_client" model="res.groups">
        <field name="name">Client</field>
        <field name="category_id" ref="module_category_clinic"/>
    </record>


