<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_client_support_tree" model="ir.ui.view">
            <field name="name">client.support.tree</field>
            <field name="model">client.support</field>
            <field name="arch" type="xml">
                <tree string="Client Support">                                                                                     
                    <field name="name"/>                                                                                    
                    <field name="description"/>
                </tree>	
            </field>
        </record>        

        <record id="view_client_support_form" model="ir.ui.view">
            <field name="name">client.support.form</field>
            <field name="model">client.support</field>
            <field name="arch" type="xml">
                <form string="Client Support">
		            <sheet>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="description"/>                                                                                    
                        </group>
		            </sheet>
                </form>
            </field>
        </record>

        <record id="client_support_action" model="ir.actions.act_window">
           <field name="name">Client Support</field>
            <field name="res_model">client.support</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_client_support_tree"/>
        </record>

     <!--creating menus-->
        <menuitem id="menu_client_support"
                  name="Client Support" 
                  parent="cml_clinic.clinic_configuration"
                  sequence="10"
                  action="cml_clinic.client_support_action"/>
</odoo>
