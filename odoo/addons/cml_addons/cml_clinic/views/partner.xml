                <page name="client_case_file" string="Case File"  
                    attrs="{'invisible': [('is_client','=',False)]}">
                        <group string="Specialist Information" colspan="4"
                            groups="cml_clinic.group_clinic_specialist,
                                    cml_clinic.group_clinic_nurse,
                                    cml_clinic.group_clinic_manager">
                            <group>
                                <field name="employee_id"/>
                                <field name="specialist_email"/>
                                <field name="specialist_jobtitle"/>
                            </group>
                            <group>
                                <field name="appointment_type"/>
                                <field name="product_id"/>
                                <button name="schedule_appointment" string="Create Appointment" type="object" class="oe_highlight" 
                                        context="{'default_partner_id': active_id,
                                            'default_duration': 1.00,
                                            'default_employee_id': employee_id,
                                            'default_appointment_type':appointment_type,
                                            'default_product_id': product_id}"/>
                            </group>
                        </group>
                    
                    <separator string="Up-Coming Appointment" colspan="4" />
                        <field name="appointment_ids" context="{'default_partner_id': active_id }" 
                            groups="cml_clinic.group_clinic_specialist,cml_clinic.group_clinic_client">
                            <tree default_order="sequence desc">
                                <field name="state" invisible="1"/>
                                <field name="sequence" groups="cml_clinic.group_clinic_specialist,cml_clinic.group_clinic_nurse"/>
                                <field name="session_start"/>
                                <field name="employee_id"/>
                                <field name="agreed_astep"/>
                                <field name="notes" string="Session Notes"/>
                            </tree>
                        </field>

                    <separator string="Appointment History" colspan="4" />
                        <field name="appt_history_ids" context="{'default_partner_id': active_id }" 
                            groups="cml_clinic.group_clinic_specialist,cml_clinic.group_clinic_client">
                            <tree default_order="sequence desc">
                                <field name="state" invisible="1"/>
                                <field name="sequence" groups="cml_clinic.group_clinic_specialist,cml_clinic.group_clinic_nurse"/>
                                <field name="session_start"/>
                                <field name="employee_id"/>
                                <field name="agreed_astep"/>
                                <field name="notes" string="Session Notes"/>
                            </tree>
                        </field>

                    <separator string="Referral" colspan="4"/>
                        <field name="referral_ids" context="{'default_partner_id': active_id }" 
                            groups="cml_clinic.group_clinic_specialist,cml_website_registration.website_agent_rule">
                            <tree> 
                                <field name="name"/>
                                <field name="user_id"/>
                                <field name="support_id"/>
                                <field name="state"/>
                            </tree>	
                        </field>
                    <separator string="Client File Records" colspan="4"/>
                        <field name="file_ids" context="{'default_partner_id': active_id }"  
                            groups="cml_clinic.group_clinic_specialist,cml_clinic.group_clinic_client">
                            <tree>
                                <field name="name"/>
                                <field name="directory"/>
                                <field name="content" filename="name"/>
                                <field name="create_uid"/>
                                <field name="write_date"/>
                            </tree>
                        </field>
                </page>
            </xpath>
        </field>
    </record>



    <record id="action_client_partner" model="ir.actions.act_window">
            <field name="name">Clients</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_type">form</field>
            <field name="view_id" ref="base.view_res_partner_filter"/>
            <field name="domain">[('is_client', '=', True)]</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
                Click to add a new Client.
              </p>
            </field>
        </record>
    
    <menuitem 
        name="Clients"
        id="clinic_client"
        parent="clinic_root"
        groups="cml_clinic.group_clinic_manager,cml_clinic.group_clinic_nurse,cml_clinic.group_clinic_client"
        sequence="25"/>
    
    <menuitem id="menu_clinic_clients"
        name="Clients" 
        parent="cml_clinic.clinic_client"
        sequence="1"
        action="action_client_partner"/>
</odoo>
