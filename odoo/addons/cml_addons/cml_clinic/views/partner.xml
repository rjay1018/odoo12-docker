<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree view for Client Information -->
    <record id="view_clinic_client_tree" model="ir.ui.view">
        <field name="name">view.clinic.client.tree</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="replace">
                <tree string="Clients">
                    <field name="display_name" string="Name"/>
                    <field name="mobile"/>
                    <field name="email"/>    
                    <field name="specialist_jobtitle"/>
                    <field name="employee_id"/>
                    <field name="specialist_email"/>
                </tree>
            </xpath> 
        </field>
    </record>

        
    <!-- Form view for Client Information -->
    <record id="view_clinic_client_form" model="ir.ui.view">
        <field name="name">view.clinic.client.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before"> 
                <header>                  
                    <field name="case_stage_id" widget="statusbar" 
                           clickable="True" groups="cml_clinic.group_clinic_nurse,cml_clinic.group_clinic_manager"
                           attrs="{'invisible': [('is_client','=',False)]}"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="string">Occupation</attribute>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                    <field name="is_client" attrs="{'invisible': [('is_company','=',True)]}"/>
            </xpath>
            
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_client','=',True)]}</attribute>
            </xpath>
            
            <xpath expr="//field[@name='lang']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_client','=',True)]}</attribute>
            </xpath>

            <xpath expr="//button[@name='toggle_active']" position="attributes">
                <attribute name="groups">cml_clinic.group_clinic_nurse,cml_clinic.group_clinic_manager</attribute>        
            </xpath>

            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="groups">cml_clinic.group_clinic_nurse,cml_clinic.group_clinic_manager</attribute>        
            </xpath>
            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="groups">cml_clinic.group_clinic_nurse,cml_clinic.group_clinic_manager</attribute> 
            </xpath>

            <xpath expr="//notebook/page[1]" position="attributes">
                <attribute name="groups">cml_clinic.group_clinic_nurse,cml_clinic.group_clinic_manager</attribute>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="groups">cml_clinic.group_clinic_nurse,cml_clinic.group_clinic_manager</attribute>
            </xpath>

            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="groups">cml_clinic.group_clinic_nurse,cml_clinic.group_clinic_manager</attribute>
            </xpath>

            <xpath expr="//page[@name='accounting']" position="attributes">
                <attribute name="groups">cml_clinic.group_clinic_nurse,cml_clinic.group_clinic_manager</attribute>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="groups">cml_clinic.group_clinic_nurse,cml_clinic.group_clinic_manager</attribute>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="before">
                <page name="personal_information_page" string="Personal Information"
                    attrs="{'invisible': [('is_client','=',False)]}"
                    groups="cml_clinic.group_clinic_specialist,cml_clinic.group_clinic_client">
                    <group>
                        <group>
                            <field name="birthday"/>
                            <field name="age"/>
                            <field name="sex"/>
                            <field name="marital"/>
                        </group>
                        <group>
                            <field name="hmo_id"/>
                            <field name="hmo_no"/>
                            <field name="clinic_visited"/>
                            <field name="philhealthid"/>
                        </group>
                        <group>
                            <field name="age_group"/>
                            <field name="source_id"/>
                            <field name="guardian"/>
                            <field name="special_priority"/>
                        </group>
                        <group>
                        </group>
                        <separator string="Emergency Contacts" colspan="4"/>
                        <field name="emergency_line_ids"> 
                            <tree editable="top">
                                <field name="name" required="1"/>
                                <field name="contact_number" required="1"/>
                                <field name="relationship"/>
                            </tree>
                        </field>
                    </group>
                </page>


