<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_specialist_availability_tree" model="ir.ui.view">
            <field name="name">specialist.availability.tree</field>
            <field name="model">specialist.availability</field>
            <field name="arch" type="xml">
                <tree string="Specialist Schedule">
                    <field name="name"/>
                </tree>	
            </field>
        </record>        

        <record id="view_specialist_availability_form" model="ir.ui.view">
            <field name="name">specialist.availability.form</field>
            <field name="model">specialist.availability</field>
            <field name="arch" type="xml">
                <form string="Specialist Schedule">
		            <sheet>
                         <group>
                             <field name="name"/>
                         </group>
		            </sheet>
                </form>
            </field>
        </record>

        <record id="view_specialty_tags_tree" model="ir.ui.view">
            <field name="name">specialty.tags.tree</field>
            <field name="model">specialty.tags</field>
            <field name="arch" type="xml">
                <tree string="Specialty">
                    <field name="name"/>
                </tree>	
            </field>
        </record>        

        <record id="view_specialty_tags_form" model="ir.ui.view">
            <field name="name">specialty.tags.form</field>
            <field name="model">specialty.tags</field>
            <field name="arch" type="xml">
                <form string="Specialty">
		            <sheet>
                         <group>
                             <field name="name"/>
                         </group>
		            </sheet>
                </form>
            </field>
        </record>

        <record id="specialist_availability_action" model="ir.actions.act_window">
            <field name="name">Availability Tags</field>
            <field name="res_model">specialist.availability</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_specialist_availability_tree"/>
        </record>

        <record id="specialty_tags_action" model="ir.actions.act_window">
            <field name="name">Specialization</field>
            <field name="res_model">specialty.tags</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_specialty_tags_tree"/>
        </record>

     <!--creating menus-->
        <menuitem id="menu_clinic_tags"
                  parent="cml_clinic.clinic_configuration"
                  name="Tags"
                  sequence="50"/>

        <menuitem id="menu_specialist_availability"
                  name="Availability" 
                  parent="cml_clinic.menu_clinic_tags"
                  sequence="20"
                  action="cml_clinic.specialist_availability_action"/>

        <menuitem id="menu_specialty_tags"
                  name="Specialization" 
                  parent="cml_clinic.menu_clinic_tags"
                  sequence="30"
                  action="cml_clinic.specialty_tags_action"/>
</odoo>