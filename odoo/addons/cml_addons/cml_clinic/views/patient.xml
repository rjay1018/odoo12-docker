<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!--tree view of the patient model-->
    <record id="patient_tree" model="ir.ui.view">
        <field name="name">clinic.patient.tree</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <tree string="Patients">
                <field name="patient_seq"/>
                <field name="name"/>
                <field name="age"/>
                <field name="sex"/>
                <field name="marital"/>
            </tree>
        </field>
     </record>

    <record id="patient_form" model="ir.ui.view">
        <field name="name">clinic.patient.form</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <form string="Patients">
                <!-- <header>
                    <button name="%(cml_clinic.create_appointment)d" string="Create Appointment" 
                    type="action" class="oe_highlight" context="{'default_patient_id': active_id, }"/>            
                </header> -->
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="open_patient_appointments" class="oe_stat_button" type="object" icon="fa-calendar">
                            <field string="Appointments" name="appointment_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="patient_seq"/>
                        </h1>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <group>
                            <field name="companyinfo"/>
                            <field name="account_number"/>
                            <field name="business_address"/>
                        </group>
                    </div>
                    <group>
                        <group>
                            <field name="birthday"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="sex"/>
                            <field name="marital"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients'}"/>
                </div>
            </form>
        </field>
    </record>
    <!--action of the patients menu-->
    <record id="action_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">clinic.patient</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create your First Patient !
          </p>
        </field>
    </record>

    <menuitem id="clinic_patient" name="Patients" parent="clinic_root" action="action_patient" sequence="10"/>

    </data>
</odoo>