<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

		<record model="ir.ui.view" id="employee_profile_update_form_view">
			<field name="name">Employee Profile Update Form</field>
			<field name="model">employee.profile.update</field>
			<field name="arch" type="xml">
				<form string="Employee Profile Update Form">
					<header>
						<field name="state" widget="statusbar" readonly="1"/>
						<button class="oe_highlight" string="Send Request" name="send_request_state" 
							type="object" attrs="{'invisible': [('state', 'not in', ('draft'))]}"/>
						<button class="oe_highlight" string="Approve" name="approve_state" 
							type="object" attrs="{'invisible': [('state', 'not in', ('request'))]}"
							groups="hr.group_hr_manager"/>
						<button class="oe_highlight" string="Cancel" name="cancel_state" 
							type="object" attrs="{'invisible': [('state', 'not in', ('request'))]}"
							groups="hr.group_hr_manager"/>
					</header>
					<sheet>
                        <div class="oe_title oe_right">
                            <h1><field name="name" readonly = "1"/></h1>
                        </div>
						<div class="oe_title oe_left">
    							<h1><field name="employee_id" 
    								attrs="{'readonly':[('state','!=','draft')]}"/></h1>
                        </div>                                
						<group>
							<group>
								<field name="date_request" 
									attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="civil_status" 
                                    attrs="{'readonly':[('state','!=','draft')]}"/>
							</group>
							<group>
								<field name="work_email" 
									attrs="{'readonly':[('state','!=','draft')]}"/>
								<field name="work_mobile" 
									attrs="{'readonly':[('state','!=','draft')]}"/>
							</group>
							<group>
								<field name="additional_notes" 
									attrs="{'readonly':[('state','!=','draft')]}"/>
							</group>
                    </group>
                        <group string='Emergency Contacts'>
                            <field name="emergency_contacts" nolabel="1" attrs="{'readonly':[('state','!=','draft')]}" context="{'default_employee_obj' : employee_id}">
                                <tree editable="Top">
                                    <field name="number"/>
                                    <field name="relation"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="number"/>
                                        <field name="relation"/>
                                    </group>
                                </form>
                            </field>
                        </group>
				    </sheet>
				    <div class="oe_chatter">
						<field name="message_follower_ids" widget="mail_followers" 
							groups="base.group_user"/>
						<field name="activity_ids" widget="mail_activity"/>
						<field name="message_ids" widget="mail_thread"/>
					</div>
				</form>
			</field>
		</record>

		<record model="ir.ui.view" id="employee_profile_update_tree_view">
			<field name="name">Employee Profile Update Tree</field>
			<field name="model">employee.profile.update</field>
			<field name="arch" type="xml">
				<tree string="Employee Profile Update Tree">
				    <field name="name"/>
					<field name="employee_id"/>
					<field name="date_request"/>
                    <field name="civil_status"/>
					<field name="work_email"/>
					<field name="work_mobile"/>
					<field name="state"/>
				</tree>
			</field>
		</record>

		<record model="ir.actions.act_window" id="employee_profile_update_page">
			<field name="name">Employee Profile Update</field>
			<field name="res_model">employee.profile.update</field>
			<field name="view_mode">tree,form</field>
			<field name="help" type="html">
				<p class="o_view_nocontent_smiling_face"> Employee Profile Update </p>
			</field>
		</record>

		<menuitem id="employee_profile_update_menu" name="Employee Profile Update"
			parent="hr.menu_hr_root" action="employee_profile_update_page"/>

	</data>
</odoo>