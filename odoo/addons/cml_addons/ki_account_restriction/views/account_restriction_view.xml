<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_restriction_form_viewss" model="ir.ui.view">
        <field name="name">Account Restriction</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']//field[@name='update_posted']" position="after">
                <field name="user_restriction"/>
                    <field name="user_restriction_ids"
                           attrs="{'invisible': [('user_restriction', '=', False)]}"
                           nolabel="1">
                        <tree editable="bottom">
                            <field name="user_id"/>
                            <field name="allow_create"/>
                            <field name="allow_validate"/>
                        </tree>
                    </field>
            </xpath>
        </field>
    </record>


