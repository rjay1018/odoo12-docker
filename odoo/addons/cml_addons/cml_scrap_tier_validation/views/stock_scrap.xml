<odoo>

    <record id="stock_scrap_form_view" model="ir.ui.view">
        <field name="name">stock.scrap.validation.form</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
        <field name="arch" type="xml">
            <button name="action_validate" position="before">
                <button name="request_validation"
                    string="Request Approval"
                    class="btn-danger"
                    attrs="{'invisible': ['|','|',('need_validation', '!=', True),('rejected','=',True),('state','not in',['draft'])]}"
                    type="object"/>
                <button name="restart_validation"
                    string="Cancel Request"
                    class="btn-warning"
                    attrs="{'invisible': ['|','|',('review_ids', '=', []),('validated', '=', True),('state','not in',['draft','sent','to approve'])]}"
                    type="object"/>
            </button>
            
            <header position="after">
                <field name="need_validation" invisible="1"/>
                <field name="validated" invisible="1"/>
                <field name="rejected" invisible="1"/>
                <div class="alert alert-warning"
                     role="alert"
                     attrs="{'invisible': ['|', '|', '|',
                     ('validated', '=', True), ('state', 'not in', ['draft','sent','to approve']),
                     ('rejected', '=', True), ('review_ids', '=', [])]}"
                     style="margin-bottom:0px;">
                    <p><i class="fa fa-info-circle"/>This needs to be Approved.
                        <field name="can_review" invisible="1"/>
                        <button name="validate_tier"
                                string="Validate"
                                attrs="{'invisible': [('can_review', '=', False)]}"
                                type="object"
                                class="oe_inline oe_button btn-success"
                                icon="fa-thumbs-up"/>
                        <button name="reject_tier"
                                string="Reject"
                                attrs="{'invisible': [('can_review', '=', False)]}"
                                type="object"
                                class="btn-icon btn-danger"
                                icon="fa-thumbs-down"/>
                    </p>
                </div>
                <div class="alert alert-success"
                     role="alert"
                     attrs="{'invisible': ['|', '|', ('validated', '!=', True), ('state', 'not in', ['draft','sent','to approve']), ('review_ids', '=', [])]}"
                     style="margin-bottom:0px;">
                    <p><i class="fa fa-thumbs-up"/> Operation has been <b>Approved</b>!</p>
                </div>
                <div class="alert alert-danger"
                     role="alert"
                     attrs="{'invisible': ['|', '|', ('rejected', '!=', True), ('state', 'not in', ['draft','sent','to approve']), ('review_ids', '=', [])]}"
                     style="margin-bottom:0px;">
                    <p><i class="fa fa-thumbs-down"/> Operation has been <b>Rejected</b>.</p>
                </div>
            </header>
            <xpath expr="//sheet" position="after">
                <field name="review_ids" widget="tier_validation" attrs="{'invisible':[('review_ids', '=', [])]}"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </xpath>
                
        </field>
    </record>

    <record id="stock_scrap_validation_view" model="ir.ui.view">
        <field name="name">stock.scrap.filter</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_search_view"/>
        <field name="arch" type="xml">
            <filter name="scrap_location" position="after">
                <filter name="needs_review" string="Needs Approval"
                        domain="[('reviewer_ids','in',uid), ('state', 'not in', ['done', 'cancel','to approve'])]"
                        help="Scrap Operation that needs approval"/>
                <filter name="tier_validated" string="Validated"
                        domain="[('validated', '=', True)]"
                        help="Scrap Operation ready to validate"/>
            </filter>
        </field>
    </record>

</odoo>
