<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        
        <record id="view_partner_survey_extend" model="ir.ui.view">
            <field name="name">Client Assessment with Specialist Score</field>
            <field name="model">survey.user_input</field>
            <field name="inherit_id" ref="survey.survey_user_input_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_survey_results']" position="after">
                    <button name="action_submit" states="done" string="Submit Assessment" type="object" 
                            class="oe_highlight" groups="cml_clinic.group_clinic_specialist"/>
                </xpath>
                <xpath expr="//field[@name='user_input_line_ids']" position="after">
                    <separator string="Specialist Assessment" colspan="4" groups="cml_clinic.group_clinic_specialist"/>                    
                        <group>
                            <field name="specialist_score" groups="cml_clinic.group_clinic_specialist"/>
                            <field name="specialist_notes" groups="cml_clinic.group_clinic_specialist"/>    
                        </group>
                </xpath>
            </field>
        </record>

        <record id="view_partner_survey_extend_tree" model="ir.ui.view">
            <field name="name">Client Assessment with Specialist Score Tree</field>
            <field name="model">survey.user_input</field>
            <field name="inherit_id" ref="survey.survey_user_input_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="specialist_score"/>
                    <field name="specialist_notes"/>
                </xpath>
                <xpath expr="//field[@name='type']" position="attributes">
				    <attribute name="invisible">True</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
