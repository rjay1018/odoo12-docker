<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="mrp_workcenter_equipment_form">
        <field name="name">mrp_workcenter_equipment_form</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='capacity']" position="before">
                <group>
                    <field name="equipment_id" required="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>