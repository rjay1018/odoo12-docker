<odoo>
    <data>

        <template id="assets_frontend" inherit_id="website.assets_frontend">
            <xpath expr="." position="inside">
                <link rel="stylesheet" href="/web/static/lib/fullcalendar/css/fullcalendar.css"/>
                <link rel="stylesheet" href="/ki_appointment_management/static/src/css/appointment.css"/>
                <script type="text/javascript" src="/web/static/lib/fullcalendar/js/fullcalendar.js"></script>
                <script type="text/javascript" src="/ki_appointment_management/static/src/js/appointment.js"></script>
            </xpath>
        </template>

        <record id="menu_website_appointment" model="website.menu">
            <field name="name">Appointment</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">20</field>
            <field name="url">/new/appointment</field>
        </record>

        <template id="appointment_template" name="New Appointment">
            <t t-call="website.layout">
                <div class="row">
                    <div class="card card-calendar col-xs-12 col-sm-12 col-md-12 col-lg-8">
                        <!-- Card header -->
                        <div class="card-header justify-content-md-center">
                            <!-- Title -->
                            <h5 class="h3 mb-0">Add New Appointment</h5>
                        </div>
                            <!-- Card body -->
                        <div class="card-body p-0">
                            <div class="calendar" data-toggle="calendar" id="calendar"></div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-4">
                        <div class="card row">
                            <h5 class="card-header">Filter By : </h5>
                            <div class="card-body" id="onhange_filter_by">
                                <div class="row">
                                    <span class="col-xs-12 col-sm-12 col-md-12 col-lg-4">Client Support :</span>
                                    <!-- div class="dropdown">
                                        <input id="client_support_id" type="hidden"/>
                                        <input id="client_support_id_search" type="text" class="dropbta" placeholder="Client Support..."/>
                                        <div id="myDropdown" class="dropdown-content">
                                            <t t-foreach="support_ids or []" t-as="support">
                                                <option t-att-value="support.id">
                                                    <t t-esc="support.name" />
                                                </option>
                                            </t>
                                        </div>
                                    </div-->
                                    <select name="support_ids" class="support_ids mdb-select md-form" searchable="Search Here..">
                                        <option value="">Client Support...</option>
                                        <t t-foreach="support_ids or []" t-as="support">
                                            <option t-att-value="support.id">
                                                <t t-esc="support.name" />
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="row">
                                    <span class="col-xs-12 col-sm-12 col-md-12 col-lg-4">Counselor :</span>
	                                    <div class="dropdown">
	                                        <input id="counselor_id" type="hidden"/>
	                                        <input id="counselor_id_search" type="text" class="dropbta" placeholder="Councellor..."/>
	                                        <div id="myDropdown" class="dropdown-content">
		                                        <t t-foreach="counselor_ids or []" t-as="counselor">
		                                            <option t-att-value="counselor.id">
		                                                <t t-esc="counselor.name" />
		                                            </option>
		                                        </t>
	                                        </div>
	                                    </div>

                                        <!-- t t-foreach="counselor_ids or []" t-as="counselor">
                                            <option t-att-value="counselor.id">
                                                <t t-esc="counselor.name" />
                                            </option>
                                        </t-->
                                </div>
                                <div class="row">
                                    <span class="col-xs-12 col-sm-12 col-md-12 col-lg-4">Time :</span>
                                    <select name="slot_ids" class="slot_ids" id="slot_ids">
                                        <option value="">Time Slots...</option>
                                        <t t-foreach="slot_ids or []" t-as="slot">
                                            <option class="okfribn" t-att-value="slot.id">
                                                <t t-esc="slot.name" />
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <script>
                            window.onclick = function(event) {
                              if (!event.target.matches('.dropbtna')) {
                                var dropdowns = document.getElementsByClassName("dropdown-content");
                                var i;
                                for (i = 0; i &lt; dropdowns.length; i++) {
                                  var openDropdown = dropdowns[i];
                                  if (openDropdown.classList.contains('show')) {
                                    openDropdown.classList.remove('show');
                                  }
                                }
                              }
                            }
                        </script>
                        <!-- div class="card card-calendar row">
                            <div class="card-header justify-content-md-center">
                                <h5 class="h3 mb-0">Available Appointment</h5>
                            </div>
                            <div class="card-body" id="refresh_mini">
                                <div class="calendar row" data-toggle="calendar" id="mini_calendar"/>
                            </div>
                        </div-->

                    </div>
                </div>
            </t>
        </template>

        <template id="appointment_create" name="New Appointment Create">
            <t t-call="website.layout">
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="color:black;">
                    <div class="row justify-content-md-center">
                        <h1>Create Appointment!</h1>
                    </div>
                    <div class="row justify-content-md-center justify-content-xs-center justify-content-sm-center justify-content-lg-center mt32">
                        <h3>Selected Date : <b><span t-esc="current_date"/></b></h3>
                    </div>
                </div>
                    <div class="row justify-content-center mt32">
                        <div class="col-xs-8 col-sm-8 col-md-8 col-lg-8 table-responsive">
                            <table class="table" id="data">
                                <t t-foreach="hr_employee_ids" t-as="o">
                                     <t t-set="confirmed_list" t-value="[]"/>
                                         <t t-foreach="o.hr_slots_ids.filtered(lambda i: str(i.date) == str(current_date))" t-as="slot">
                                             <t t-set="confirmed_lists" t-value="confirmed_list.append(slot.slot_id.id)"/>
                                         </t>
                                         <t t-set="confirm_list" t-value="[]"/>
                                         <t t-foreach="o.schedule_line_ids.filtered(lambda i: i.day == str(week))" t-as="avai">
                                             <t t-foreach="avai.availability_ids" t-as="i">
                                                 <t t-set="confirm_lists" t-value="confirm_list.append(i.id)"/>
                                             </t>
                                         </t>
                                    <tr t-if="len(availability_ids.filtered(lambda i: i.id in confirm_list)) > 0">
                                        <th class="text-center">
                                            
                                            <div class="row justify-content-center" >
                                                <div class="col-xs-4 col-sm-4 col-md-4 col-lg-4">
                                                    <div class="row justify-content-center">
                                                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="width: 8rem;">
                                                            <span t-field="o.image" t-options="{'widget': 'image', 'class': 'rounded'}" />
                                                        </div>
                                                        <h4 class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="color:black;" t-field="o.name"/>
                                                        <div class="modal" t-att-id="'modal_pop_' + str(o.id)" tabindex="-1" role="dialog" >
                                                            <div class="modal-dialog modal-dialog-centered" role="document">
                                                                <div class="modal-content">
                                                                    <div class="modal-header justify-content-center">
                                                                        <h3 class="modal-title" style="color:black;">Wellness Coach Profile</h3>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <div class="row">
                                                                            <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
                                                                                <span t-field="o.image" t-options="{'widget': 'image', 'class': 'rounded'}" />
                                                                            </div>
                                                                            <div class="col-xs-9 col-sm-9 col-md-9 col-lg-9">
                                                                                <div class="form-group row">
                                                                                    <label class="col-xs-12 col-sm-12 col-md-4 col-lg-4 text-left col-form-label">Name:</label>
                                                                                    <div>
                                                                                        <span class="form-control-plaintext text-left" t-field="o.name"/>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="form-group row">
                                                                                    <label class="col-xs-12 col-sm-12 col-md-4 col-lg-4 text-left col-form-label">Specialization:</label>
                                                                                    <div>
                                                                                        <span class="form-control-plaintext text-left" t-field="o.specialty_ids"/>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="form-group row">
                                                                                    <label class="col-xs-12 col-sm-12 col-md-4 col-lg-4 text-left col-form-label">Non-Preference:</label>
                                                                                    <div>
                                                                                        <span class="form-control-plaintext text-left" t-field="o.nonpreference"/>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="form-group row">
                                                                                    <label class="col-xs-12 col-sm-12 col-md-4 col-lg-4 text-left col-form-label">Pseudonym:</label>
                                                                                    <div>
                                                                                        <span class="form-control-plaintext text-left" t-field="o.pseudonym"/>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-12">
                                                                                <div class="form-group row">
                                                                                    <label class="col-xs-12 col-sm-12 col-md-4 col-lg-4 text-left col-form-label">Profile Sumary:</label>
                                                                                    <div>
                                                                                        <span class="form-control-plaintext text-left" t-field="o.summary" widget="html"/>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <a href="#" data-toggle="modal" t-att-data-target="'#modal_pop_' + str(o.id) " class="btn btn-primary">View Profile</a>
                                                    </div>
                                                </div>
                                                <t t-if="len(availability_ids.filtered(lambda i: i.id in confirm_list)) == 0">
                                                    <div class="col-xs-8 col-sm-8 col-md-8 col-lg-8 justify-content-center" style="display:flex;align-items:center;">
                                                        <h2>Currently No Slot Available !!</h2>
                                                    </div>
                                                </t>
                                                <t t-else="">
                                                    <div class="col-xs-8 col-sm-8 col-md-8 col-lg-8" id="slot_booking">
                                                        <t t-foreach="availability_ids.filtered(lambda i: i.id in confirm_list)" t-as="a">
                                                            <t t-if="a.id not in (confirmed_list or [])">
                                                                <button type="button" class="btn btn-outline-primary slot_allot" style="margin-left: 20px;margin-top: 20px;" t-att-value="str(o.id)+','+str(a.id)"> <t t-esc="'%02d:%02d' % (int(a.time), a.time % 1 * 60)"/></button>
                                                            </t>
                                                        </t>
                                                    </div>
                                                </t>
                                            </div>
                                        </th>
                                    </tr>
                                </t>
                            </table>
                            <nav aria-label="page" class="float-right">
                                <ul class="pagination" id="nav"/>
                            </nav>
                        </div>
                        <div class="col-xs-4 col-sm-4 col-md-4 col-lg-4">
                            <div class="sticky-top" style="color:black;top:120px">
                                <form t-att-action="'/new/appointment/submit/'" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="form-group">
                                        <label for="service_id" class="float-left">Select Service:</label>
                                        <select name="service_id" class="form-control" required="">
                                            <option value="">Service...</option>
                                            <t t-foreach="product_ids or []" t-as="service">
                                                <option t-att-value="service.id" t-att-selected="service.id == int(default_product_id) if default_product_id else 0 ">
                                                    <t t-esc="service.name" />
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <input type="hidden" id="slot_id_" name="slot_id" />
                                    <input type="hidden" name="hr_employee_ids" t-att-value="(',').join(map(str, hr_employee_ids.ids))"/>
                                    <div class="form-group">
                                        <label for="name" class="float-left">Your Name:</label>
                                        <input type="text" class="form-control" name="name" placeholder="Your Name" t-att-value="default_name" required=""/>
                                    </div>
                                    <div class="form-group">
                                        <input class="form-control" name="date" type="hidden" t-att-value="current_date"/>
                                    </div>
                                    <!--
                                    <div class="form-group">
                                        <label for="description" class="float-left">Message To Coach:</label>
                                        <textarea class="form-control" name="description" rows="3" placeholder="Message To Coach" required=""/>
                                    </div>
                                    -->
                                    <button type="submit" class="btn btn-primary">Confirm</button>
                                    <div t-if="error" class="alert alert-warning" role="alert">
                                        <strong><span t-esc="error"/></strong>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
            </t>
        </template>
    </data>
</odoo>