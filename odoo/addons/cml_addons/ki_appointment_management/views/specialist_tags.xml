<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_specialist_availability_tree_inherit" model="ir.ui.view">
            <field name="name">specialist.availability.tree.inherit</field>
            <field name="model">specialist.availability</field>
            <field name="inherit_id" ref="cml_clinic.view_specialist_availability_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="time" widget="float_time"/>
                </xpath>
            </field>
        </record>        

        <record id="view_specialist_availability_form_inherit" model="ir.ui.view">
            <field name="name">specialist.availability.form.inherit</field>
            <field name="model">specialist.availability</field>
            <field name="inherit_id" ref="cml_clinic.view_specialist_availability_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="time" widget="float_time"/>
                </xpath>
            </field>
        </record>
</odoo>