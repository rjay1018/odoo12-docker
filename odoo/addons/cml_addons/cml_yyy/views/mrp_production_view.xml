<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_extension_form_inherit" model="ir.ui.view">
        <field name="name">view_mrp_extension_form_inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_id']" position="before">
                <field name="difference_by_count" readonly="1"/>
                <field name="difference_by_percentage" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
