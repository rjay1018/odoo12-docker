<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="rma_main_yyy" model="ir.ui.view">
            <field name="name">rma_main_yyy</field>
            <field name="model">rma.main</field>
            <field name="inherit_id" ref="bi_rma.view_rma_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="/form/*" position="before">
                    <header>
                        <widget name="attach_document" string="Attach Pictures" action="message_post" highlight="1" required="1"/>
                    </header>
                </xpath>
                <sheet position="after">
                    <div class="o_attachment_preview"/>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </field>
        </record>
    </data>
</odoo>
