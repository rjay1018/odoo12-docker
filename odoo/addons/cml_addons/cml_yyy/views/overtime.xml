<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_overtime_yyy" model="ir.ui.view">
            <field name="name">hr_overtime_yyy</field>
            <field name="model">hr.overtime</field>
            <field name="inherit_id" ref="ph_payroll_overtime.hr_overtime_form"/>
            <field name="arch" type="xml">
            <xpath expr="/form/*" position="before">
                <header>
                    <widget name="attach_document" string="Attach Document" action="message_post" highlight="1" />
                </header>
            </xpath>
                <sheet position="after">
                    <div class="o_attachment_preview"/>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </field>
        </record>
    </data>
</odoo>