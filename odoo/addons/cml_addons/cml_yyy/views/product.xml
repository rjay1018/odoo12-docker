<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_yyy" model="ir.ui.view">
            <field name="name">product.temp.from.view.inherit</field>
            <field name="model">product.template</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[last()]" position="before">
                    <page name="qa_product_info" string="QA Team">
                        <separator string="QA Product Information"/>
                        <field name="description_qa"/>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>