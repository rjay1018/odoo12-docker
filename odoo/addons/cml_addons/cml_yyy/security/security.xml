<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_franchise_user" model="res.groups">
        <field name="name">Franchise Ordering</field>
<!--        <field name="name">Franchise User</field>-->
    </record>

    <record model="ir.rule" id="franchise_user">
        <field name="name">Franchise Profile</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_franchise_user'))]"/>
    </record>

    <!-- RMA USER ACCESS -->
    <record id="group_rma_user" model="res.groups">
        <field name="name">RMA User</field>
    </record>

    <record id="group_rma_manager" model="res.groups">
        <field name="name">RMA Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_rma_user'))]"/>
    </record>

</odoo>
