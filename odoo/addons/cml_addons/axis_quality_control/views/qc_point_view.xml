    <!-- Quality Point -->
    <record id="quality_point_form_view_html" model="ir.ui.view">
        <field name="name">quality.point.form.view.html</field>
        <field name="model">sh.qc.point</field>
        <field name="inherit_id" ref="sh_inventory_mrp_qc.quality_point_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
				<header>
				    <button name="get_routing_operation" type="object" string="Get Routing Operation" class="oe_highlight"/>
				</header>
			</xpath>
			<xpath expr="//sheet/notebook/page/field[@name='sh_instruction']" position="attributes">
				<attribute name="widget">html</attribute>
			</xpath>
			<xpath expr="//sheet/notebook/page[1]" position="after">
				<page string="Routing Workcenter">
                     <field name="routing_workcenter_ids">
                         <tree string="Routing Workcenter" editable="top" create="false" edit="true">
                             <field name="operation_name" readonly="1"/>
                             <field name="workcenter_id" readonly="1"/>
                             <field name="allow_quality_check"/>
                             <field name="product_id" readonly="1"/>
                         </tree>
                         <form string="Routing Workcenter">
                            <group>
                                <group>
                                    <field name="operation_name" readonly="1"/>
                                    <field name="workcenter_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="allow_quality_check"/>
                                     <field name="product_id" readonly="1"/>
                                     <field name="qc_point_id" invisible="1"/>
                                </group>
                            </group>
                         </form>
                    </field>
                </page>
			</xpath>
			<xpath expr="//sheet/group/group/field[@name='logged_user']" position="after">
				<field name="hazard_id"/>
				<field name="likelihood_id"/>
				<field name="severity_id"/>
				<field name="rating_id"/>
			</xpath>
		</field>
	</record>
	
	
	<!-- Work Order -->
    <record id="mrp_production_workorder_form_view_inherit_boolean" model="ir.ui.view">
        <field name="name">mrp.workorder.quality.boolean</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
			<xpath expr="//sheet/group/group/field[@name='product_id']" position="after">
				<field name="allow_quality_check" invisible="0"/>
			</xpath>
		</field>
	</record>
	
	<record id="sh_inventory_mrp_qc.sh_mrp_work_order_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit</field>
        <field name="model">mrp.workorder</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit" />
        <field name="arch" type="xml">
            <xpath expr="/form/header/field[@name='state']" position="before">
                <field name="qc_button_hide" invisible="1"/>
                <button name="workorder_quality_point" type="object" string="Quality Checks"
                        class="oe_highlight" attrs="{'invisible':['|','|','|', ('need_qc', '=', False),
                        ('allow_quality_check', '=', False), ('qc_pass','=', True), ('qc_button_hide', '=', True)]}"
                        groups="sh_inventory_mrp_qc.sh_quality_control_user" />
                <button name="action_quality_alert" type="object" string="Quality Alerts" class="oe_highlight" attrs="{'invisible':['|',('need_qc', '=', False),('allow_quality_check', '=', False)]}" groups="sh_inventory_mrp_qc.sh_quality_control_user" />
            </xpath>

            <xpath expr="//form/sheet/div[@name='button_box']" position="inside">
                <button name="open_quality_check" class="oe_stat_button" icon="fa-check" type="object" attrs="{'invisible':['|',('need_qc', '=', False),('allow_quality_check', '=', False)]}" groups="sh_inventory_mrp_qc.sh_quality_control_user">
                    <field name="qc_count" widget="statinfo" string="Quality Checks" />
                </button>

                <button name="open_quality_alert" class="oe_stat_button" icon="fa-warning" type="object" attrs="{'invisible':['|',('need_qc', '=', False),('allow_quality_check', '=', False)]}" groups="sh_inventory_mrp_qc.sh_quality_control_user">
                    <field name="qc_alert_count" widget="statinfo" string="Quality Alerts" />
                </button>
            </xpath>

            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <div class="alert alert-info text-center o_form_header" attrs="{'invisible': ['|','|','|',('qc_fail','=',True),('qc_pass','=',True),('need_qc', '=', False),('allow_quality_check', '=', False)]}" role="alert">
                    <div>
                        <strong>Product(s) Quality Control Still Pending.</strong>
                    </div>
                </div>
                <div class="alert alert-info text-center o_form_header" style="background: #efd9d9; color: maroon; border: 1px solid #e9b4b4;" attrs="{'invisible': ['|',('qc_fail','=',False),('allow_quality_check', '=', False)]}" role="alert">
                    <div>
                        <strong>Product(s) Quality Control Failed.</strong>
                    </div>
                </div>
                <div class="alert alert-info text-center o_form_header" style="background: #dceddd; color: green; border: 1px solid #b4efb9;" attrs="{'invisible': ['|',('qc_pass','=',False),('allow_quality_check', '=', False)]}" role="alert">
                    <div>
                        <strong>Product(s) Quality Control Successfully Passed</strong>
                    </div>
                </div>
            </xpath>

            <xpath expr="//group/group" position="inside">
                <field name="need_qc" invisible="1" />
                <field name="qc_fail" invisible="1" />
                <field name="qc_pass" invisible="1" />
                <field name="pending_qc" invisible="1" />
                <field name="is_mandatory" invisible="1" />
                <field name="sh_workorder_quality_point_id" invisible="1" />
            </xpath>

            <xpath expr="//notebook//page[1]" position="after">
                <page string="Quality Checks" groups="sh_inventory_mrp_qc.sh_quality_control_user" attrs="{'invisible':['|',('need_qc', '=', False),('allow_quality_check', '=', False)]}">
                    <field name="sh_mrp_workorder_quality_check_ids">
                        <tree decoration-danger="state == 'fail'" decoration-success="state == 'pass'">
                            <field name="product_id" required="1" />
                            <field name="sh_date" required="1" />
                            <field name="sh_control_point" required="1" />
                            <field name="control_point_id" required="1" />
                            <field name="qc_type" required="1" />
                            <field name="state" />
                            <field name="text_message" attrs="{'invisible':[('qc_type','!=','type4')]}" />
                            <field name="sh_norm" attrs="{'invisible':[('qc_type','!=','type2')]}" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </tree>
                    </field>
                    <group>
                        <group>
                            <lable for="attachment_ids" />
                            <field name="attachment_ids" widget="many2many_binary" />
                        </group>
                    </group>
                </page>
                <page string="Quality Alerts" groups="sh_inventory_mrp_qc.sh_quality_control_user" attrs="{'invisible':['|',('need_qc', '=', False),('allow_quality_check', '=', False)]}">
                    <field name="sh_mrp_workorder_quality_alert_ids" />
                </page>
                </xpath>
                <xpath expr="//button[@name='record_production']" position="replace">
	                <button name="record_production"
	                 type="object" 
	                 string="Done" 
	                 class="btn-success"
	                 attrs="{'invisible': ['|','|', '|', '|',('is_produced', '=', True)
	                 ,('working_state', '=', 'blocked'),('state', '!=', 'progress'),('is_user_working', '=', False)]}"
	                  />
	            </xpath>      
        </field>
    </record>
    
    <!-- Work Order -->
    <record id="sh_mrp_measurement_wizard_form_view_html" model="ir.ui.view">
        <field name="name">sh.mrp.measurement.wizard.form.view.html</field>
        <field name="model">sh.mrp.measurement</field>
        <field name="inherit_id" ref="sh_inventory_mrp_qc.sh_mrp_measurement_wizard_form_view"/>
        <field name="arch" type="xml">
			<xpath expr="//div/field[@name='sh_message']" position="attributes">
				<attribute name="widget">html</attribute>
			</xpath>
		</field>
	</record>
	

    </data>
</odoo>
