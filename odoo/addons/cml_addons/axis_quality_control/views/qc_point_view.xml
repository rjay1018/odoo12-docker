<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
	<!-- Hazard -->
	<record id="quality_hazard_form_view" model="ir.ui.view">
        <field name="name">quality.hazard.form.view</field>
        <field name="model">quality.hazard</field>
        <field name="arch" type="xml">
            <form string="Hazard">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>
    <record id="quality_hazard_tree_view" model="ir.ui.view">
        <field name="name">quality.hazard.tree.view</field>
        <field name="model">quality.hazard</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="quality_hazard_action" model="ir.actions.act_window">
        <field name="name">Hazard</field>
        <field name="res_model">quality.hazard</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="quality_hazard_tree_view" />
    </record>
    
    <menuitem id="quality_hazard_menu" 
            name="Hazard" 
            parent="sh_inventory_mrp_qc.quality_control_config" 
            action="quality_hazard_action" 
            sequence="5" />
            
