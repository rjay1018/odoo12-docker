<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="appointment_form_inherit_apply_for_free_session">
            <field name="name">appointment.inherit.apply.for.free.session</field>
            <field name="model">clinic.appointment</field>
            <field name="inherit_id" ref="cml_appointment_extends.appointment_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='multi_service_ids']" position="before">
                    <group>
                        <group>
                            <button name="actin_apply_free_session" string="Apply Free Session" type="object"
                                    class="oe_highlight" invisible="1"/>
                        </group>
                        <group>
                            <field name="available_session" invisible="1"/>
                        </group>
                    </group>

                </xpath>
            </field>
        </record>
    </data>

</odoo>
