<odoo>
    <data>
        <record model="ir.ui.view" id="request_partner_wizard_view">
            <field name="name">request.partner.wizard.form</field>
            <field name="model">request.partner</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                         <group>
                             <field name="partner_id"/>
                         </group>
                    </group>
                    <footer>
                        <button name="submit_record" string="Submit" type="object"/>
                        <button name="cancel"  special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>
         <record model="ir.actions.act_window" id="request_partner_wizard_action_menu">
             <field name="name">Generate PO</field>
             <field name="res_model">request.partner</field>
             <field name="view_type">form</field>
             <field name="view_mode">form</field>
             <field name="target">new</field>
         </record>
    </data>
</odoo>
