<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_tags" model="ir.ui.view">
        <field name="name">product.template.form.tags</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_income_id']" position="after">
                <field name="sale_analytic_tag_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='property_account_expense_id']" position="after">
                <field name="purchase_analytic_tag_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>


</odoo>
