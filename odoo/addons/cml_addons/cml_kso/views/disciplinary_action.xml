<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
      <record id="employee_form_inherit_disciplinary_kso" model="ir.ui.view">
          <field name="name">inherit.disciplinary.form.view</field>
          <field name="model">disciplinary.action</field>
          <field name="inherit_id" ref="hr_disciplinary_tracking.employee_disciplinary_form"/>
          <field name="arch" type="xml">
            <xpath expr="//field[@name='joined_date']" position="attributes">
              <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='discipline_reason']" position="attributes">
              <attribute name="string">Violation</attribute>
            </xpath>
            <xpath expr="//field[@name='action']" position="attributes">
              <attribute name="string">Warning</attribute>
            </xpath>
            <xpath expr="//field[@name='department_name']" position="after">
              <field name="position"/>
            </xpath>
            <xpath expr="//field[@name='discipline_reason']" position="after">
              <group>  
                <field name="date_violation"/>
                <field name="date_issued"/>        
              </group>
            </xpath>
          </field>
      </record>

