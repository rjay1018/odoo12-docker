<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- # For existing database only
        # Delete the original cron and re-create
        # fix value for field `code`
        <delete id="ph_payroll_employee.cron_years_in_service" model="ir.cron"/> -->

        <record id="cron_years_in_service" model="ir.cron">
            <field name="name">Employee: Years in Service</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="model_hr_employee"/>
            <field name="code">model._cron_years_in_service()</field>
            <field name="state">code</field>
            <field name="nextcall" eval="(datetime.utcnow() + timedelta(days=0)).strftime('%Y-%m-%d 16:00:00')"/>
            <field name="priority">1</field>
        </record>

        <record id="cron_compute_age" model="ir.cron">
            <field name="name">Employee: Compute Age</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="model_hr_employee"/>
            <field name="code">model._cron_compute_age()</field>
            <field name="state">code</field>
            <field name="nextcall" eval="(datetime.utcnow() + timedelta(days=0)).strftime('%Y-%m-%d 16:00:00')"/>
            <field name="priority">1</field>
        </record>

    </data>
</odoo>
