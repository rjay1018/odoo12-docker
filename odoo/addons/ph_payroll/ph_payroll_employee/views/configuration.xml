<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_form_inherit_emp" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.emp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='hr']" position="inside">
                <h2>Employee</h2>
                <div class="row mt16 o_settings_container" id="employee_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="employee_name_format" string="Name Format"/>
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    Name format for the employees
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="employee_name_format" required="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="employee_name_letter_case" string="Letter Case"/>
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    Employee name letter case
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="employee_name_letter_case" required="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
