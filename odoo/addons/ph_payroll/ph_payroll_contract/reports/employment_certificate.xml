<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_employment_cert_document">
        <div class="header pt-3" style="font-size: 12px">
            <div class="row border-bottom pb-3 justify-content-center">
                <div class="col-2 text-right pr-1">
                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="height: 50px;"/>
                </div>
                <div class="col-10 pl-1">
                    <strong><span style="font-size: 13pt" t-field="o.company_id.name"/></strong><br/>
                    <span style="font-size: 11pt" t-esc="o.employee_id._get_company_address()"/>
                </div>
            </div>
        </div>
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
            <div class="row justify-content-center pb-4">
                <div class="col-12 text-center">
                    <h2>CERTIFICATE OF EMPLOYMENT</h2>
                </div>
            </div>
            <div class="page">
                <div class="oe_structure"/>
                <table class="table table-borderless" style="font-size: 13pt">
                    <tbody>
                        <tr>
                            <td class="text-justify">
                                <span class="pl-5">This is to certify that</span>
                                <span class="pl-1 pr-1" t-field="o.employee_id.name"/>was an employee of
                                <span class="pl-1 pr-1" t-esc="o.company_id.name"/>from
                                <span class="pl-1 pr-1" t-esc="o._get_employment_contract(True)['date_start']"/> up to
                                <span class="pl-1 pr-1" t-esc="o._get_employment_contract(True)['date_end']"/> as
                                <span class="pl-1" t-esc="o._get_employment_contract(True)['current_position']"/>
                                <br/><br/><br/>
                                <span class="pl-5">This certification is being issued to Mr./Ms.</span>
                                <span class="pl-1 pr-1" t-field="o.employee_id.last_name"/>
                                <span>for whatever legal purpose it may serve</span>
                                <br/><br/><br/>
                                <span class="pl-5">Given this</span>
                                <span class="pl-1 pr-1" t-esc="o._get_employment_contract(True)['day']"/><span>day of</span>
                                <span class="pl-1" t-esc="o._get_employment_contract(True)['month']"/>,
                                <span class="pl-1 pr-1" t-esc="o._get_employment_contract(True)['year']"/>at
                                <span t-esc="o.employee_id._get_company_address()"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="row justify-content-end pt-5 mt-5">
                    <div class="col-12">
                        <div class="float-right text-center">
                            <span>____________________________</span><br/>
                            <span class="pt-3">Name and signature of issuer</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="report_employment_cert">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ph_payroll_contract.report_employment_cert_document"/>
            </t>
        </t>
    </template>

    <record id="paperformat_emp_cert_contract" model="report.paperformat">
        <field name="name">Employee Certificate</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">20</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">25</field>
        <field name="dpi">90</field>
    </record>

    <report
        string="Employment Certificate"
        id="action_report_employment_cert"
        model="hr.contract"
        report_type="qweb-pdf"
        name="ph_payroll_contract.report_employment_cert"
        file="ph_payroll_contract.report_employment_cert"
        paperformat="ph_payroll_contract.paperformat_emp_cert_contract"/>

</odoo>
