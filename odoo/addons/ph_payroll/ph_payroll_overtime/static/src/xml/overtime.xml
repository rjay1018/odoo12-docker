<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t t-name="OvertimeView.multi_advance_overtime">
        <button type="button" class="btn btn-primary o_button_multi_advance_overtime">
            Advance Filing
        </button>
    </t>
    <t t-extend="ListView.buttons" t-name="OvertimeView.buttons">
        <t t-jquery="button.o_list_button_add" t-operation="after">
            <t t-js="ctx">
                if (window.odoo._modules.indexOf("base_import") >= 0) {
                    r.push(context.engine.tools.call(context, 'ImportView.import_button', dict));
                };
            </t>
            <t t-call="OvertimeView.multi_advance_overtime"/>
        </t>
    </t>

</templates>
