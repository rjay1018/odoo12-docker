<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <menuitem id="hr_attendance.menu_hr_attendance_settings" name="Configuration"
        parent="hr_attendance.menu_hr_attendance_root"
        sequence="99"
        groups="hr_attendance.group_hr_attendance_manager"/>

    <menuitem id="menu_attendance_settings" name="Settings"
        parent="hr_attendance.menu_hr_attendance_settings"
        sequence="10"
        action="hr_attendance.action_hr_attendance_settings"
        groups="hr_attendance.group_hr_attendance_manager"/>


    <record model="ir.ui.view" id="nd_pay_rate_tree">
        <field name="name">nd.pay.rate.tree</field>
        <field name="model">hr.nd.pay.rate</field>
        <field name="arch" type="xml">
            <tree string="Night Diff. Pay Rate" editable="bottom">
                <field name="name"/>
                <field name="rate"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="nd_pay_rate_form">
        <field name="name">nd.pay.rate.form</field>
        <field name="model">hr.nd.pay.rate</field>
        <field name="arch" type="xml">
            <form string="Night Diff. Pay Rate">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nd_pay_rate" model="ir.actions.act_window">
        <field name="name">Night Diff. Pay Rates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.nd.pay.rate</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_nd_pay_rate"
        parent="hr_attendance.menu_hr_attendance_settings"
        action="action_nd_pay_rate"
        sequence="5"/>

</odoo>
