<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="hr_pass_slip_tree">
        <field name="name">hr.pass.slip.tree</field>
        <field name="model">hr.pass.slip</field>
        <field name="arch" type="xml">
            <tree string="Pass Slip">
                <field name="employee_id"/>
                <field name="transaction_type"/>
                <field name="time_out"/>
                <field name="time_in"/>
                <field name="duration" widget="float_time" sum="Total"/>
                <field name="destination"/>
                <field name="notes"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="hr_pass_slip_search">
        <field name="name">hr.pass.slip.search</field>
        <field name="model">hr.pass.slip</field>
        <field name="arch" type="xml">
            <search string="Pass Slip">
                <field name="employee_id"/>
                <field name="transaction_type"/>
                <field name="destination"/>
                <field name="notes"/>
                <filter name="grp_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="grp_transact_type" string="Transaction Type" context="{'group_by': 'transaction_type'}"/>
                <filter name="grp_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="hr_pass_slip_form">
        <field name="name">hr.pass.slip.form</field>
        <field name="model">hr.pass.slip</field>
        <field name="arch" type="xml">
            <form string="Pass Slip">
                <header>
                    <button type="object" name="action_confirm" states="draft" string="Confirm" class="oe_highlight"/>
                    <button type="object" name="action_approve" states="confirm" string="Approve" class="oe_highlight"/>
                    <button type="object" name="action_draft" states="confirm,approve" string="Set to Draft"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" domain="[('id', '&gt;', 1)]" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="contract_id" readonly="1" force_save="1"/>
                            <field name="time_out" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="time_in" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="duration" widget="float_time"/>
                            <field name="date" required="1" readonly="0" force_save="1"
                                attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="payroll_period_id" required="1" force_save="1"/>
                        </group>
                        <group>
                            <field name="transaction_type" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="destination" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="notes" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pass_slip" model="ir.actions.act_window">
        <field name="name">Pass Slip</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.pass.slip</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_pass_slip"
        parent="hr_attendance.menu_hr_attendance_manage_attendances"
        action="action_pass_slip"
        sequence="12"/>

</odoo>
