<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_check_validity" model="ir.cron">
            <field name="name">Leave Allocation: Check Validity</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="model_hr_leave_allocation"/>
            <field name="code">model._cron_check_validity()</field>
            <field name="state">code</field>
            <field name="nextcall" eval="(datetime.utcnow() + timedelta(days=0)).strftime('%Y-%m-%d 16:00:00')"/>
            <field name="priority">1</field>
        </record>

    </data>
</odoo>
