<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="grp_emp_own_leave" model="res.groups">
            <field name="name">Employee Own Leave</field>
            <field name="category_id" ref="ph_payroll_computation.mod_categ_ph_payroll"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_emp_own_leave" model="ir.rule">
            <field name="name">Employee Own Leave</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave" />
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('grp_emp_own_leave'))]"/>
        </record>

        <record id="hr_holidays.hr_leave_rule_employee" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

        <record id="hr_holidays.hr_leave_allocation_rule_employee" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

        <record id="hr_holidays.hr_leave_allocation_rule_employee_update" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

        <record id="hr_holidays.hr_leave_rule_multicompany" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
