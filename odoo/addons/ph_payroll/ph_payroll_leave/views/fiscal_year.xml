<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <menuitem id="menu_fiscal_year"
        action="account.actions_account_fiscal_year"
        parent="hr_holidays.menu_hr_holidays_configuration"
        groups="hr_holidays.group_hr_holidays_manager"
        sequence="2"/>


   <record id="fiscal_year_inherit_form" model="ir.ui.view">
        <field name="name">fiscal.year.inherit.form</field>
        <field name="model">account.fiscal.year</field>
        <field name="inherit_id" ref="account.action_account_fiscal_year_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="replace">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="fiscal_year_inherit_tree" model="ir.ui.view">
        <field name="name">fiscal.year.inherit.tree</field>
        <field name="model">account.fiscal.year</field>
        <field name="inherit_id" ref="account.action_account_fiscal_year_tree"/>
        <field name="arch" type="xml">
            <field name="company_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

</odoo>
