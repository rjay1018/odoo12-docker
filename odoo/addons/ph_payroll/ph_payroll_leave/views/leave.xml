<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_holidays.hr_leave_menu_my" model="ir.ui.menu">
        <field name="groups_id" eval="[(3, ref('base.group_user')), (4, ref('hr_holidays.group_hr_holidays_user')), (4, ref('hr_holidays.group_hr_holidays_manager')), (4, ref('grp_emp_own_leave'))]"/>
    </record>


    <!-- LEAVE TYPE -->
    <record model="ir.ui.view" id="leave_type_inherit_form">
        <field name="name">leave.type.inherit.form</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div/button[@name='action_see_days_allocated']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div/button[@name='action_see_group_leaves']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='description']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='visibility']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='validity']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='calendar']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='validation']" position="before">
                <group name="leave_type" string="Type">
                    <field name="leave_type" widget="radio"/>
                </group>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <group name="notes">
                    <field name="notes" colspan="4"/>
                </group>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="leave_type_inherit_tree">
        <field name="name">leave.type.inherit.tree</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="replace">
                <tree string="Leave Type">
                    <field name="display_name" string="Name"/>
                    <field name="leave_type"/>
                    <field name="allocation_type" invisible="1"/>
                    <field name="validation_type" invisible="1"/>
                    <field name="double_validation"/>
                    <field name="notes"/>
                    <field name="validity_start" invisible="1"/>
                    <field name="validity_stop" invisible="1"/>
                </tree>
            </xpath>
        </field>
    </record>


    <!-- LEAVE ALLOCATION -->
    <record model="ir.ui.view" id="leave_allocation_inherit_search">
        <field name="name">leave.allocation.inherit.search</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_leave_allocation_filter"/>
        <field name="arch" type="xml">
            <filter name="approve" position="before">
                <filter domain="[('state', '=', 'draft')]" string="To Confirm" name="confirm"/>
            </filter>
            <filter name="approve" position="attributes">
                <attribute name="domain">[('state', '=', 'confirm')]</attribute>
            </filter>
            <filter name="validated" position="replace"/>
            <filter name="accrual_allocation" position="replace"/>
            <filter name="active_types" position="replace"/>
            <filter name="message_needaction" position="replace"/>
            <filter name="department" position="replace"/>
            <filter name="my_team_leaves" position="replace"/>
            <filter name="year" position="replace"/>
            <filter name="my_leaves" position="replace"/>
            <filter name="activities_overdue" position="replace"/>
            <filter name="activities_today" position="replace"/>
            <filter name="activities_upcoming_all" position="replace"/>
            <filter name="group_name" position="replace"/>
            <filter name="group_category" position="replace"/>
            <filter name="group_second_approver_id" position="replace"/>
            <filter name="group_type" position="attributes">
                <attribute name="string">Leave Type</attribute>
            </filter>
            <filter name="group_type" position="after">
                <filter name="group_fiscal_year" string="Fiscal Year" context="{'group_by': 'fiscal_year_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </filter>
        </field>
    </record>

    <record model="ir.ui.view" id="leave_allocation_inherit_tree">
        <field name="name">leave.allocation.inherit.tree</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="replace"/>
            <field name="duration_display" position="replace">
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="fiscal_year_id"/>
                <field name="accumulated_leave"/>
                <field name="number_of_days"/>
                <field name="total_allocation"/>
                <field name="convertible_leave"/>
                <field name="leave_count"/>
                <field name="leave_balance"/>
                <field name="notes"/>
                <field name="converted"/>
            </field>
        </field>
    </record>

    <record id="leave_allocation_form" model="ir.ui.view">
        <field name="name">leave.allocation.form</field>
        <field name="model">hr.leave.allocation</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Leave Allocation">
                <header>
                    <button string="Confirm" name="action_confirm" states="draft" type="object"
                        groups="hr_holidays.group_hr_holidays_manager" class="oe_highlight"/>
                    <button string="Approve" name="action_approve" states="confirm" type="object"
                        groups="hr_holidays.group_hr_holidays_manager" class="oe_highlight"/>
                    <button string="Expire" name="action_expire" states="validate" type="object"
                        groups="hr_holidays.group_hr_holidays_manager"/>
                    <button string="Cancel" name="action_refuse" states="confirm,validate" type="object"
                        groups="hr_holidays.group_hr_holidays_manager"/>
                    <button string="Set to Draft" name="action_draft" states="confirm,expire,refuse" type="object"
                        groups="hr_holidays.group_hr_holidays_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="absence" invisible="1"/>
                        <group>
                            <field name="employee_id" domain="[('id', '&gt;', 1)]"
                                attrs="{'readonly': [('state', '!=', 'draft')], 'required': [('absence', '=', False)], 'invisible': [('absence', '!=', False)]}"/>
                            <field name="holiday_status_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"
                                domain="[('absence', '=', False)]" options="{'no_create': True}"/>
                            <field name="fiscal_year_id"
                                attrs="{'readonly': [('state', '!=', 'draft')], 'required': [('absence', '=', False)], 'invisible': [('absence', '!=', False)]}"
                                options="{'no_open': True, 'no_create': True}"/>
                            <field name="valid_from" attrs="{'readonly': [('state', '!=', 'draft')], 'required': [('absence', '=', False)]}"/>
                            <field name="valid_to" attrs="{'readonly': [('state', '!=', 'draft')], 'required': [('absence', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="accumulated_leave" readonly="1" force_save="1"
                                attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('absence', '!=', False)]}"/>
                            <field name="number_of_days" required="1"
                                attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('absence', '!=', False)]}"/>
                            <field name="total_allocation" readonly="1" force_save="1"
                                attrs="{'invisible': [('absence', '!=', False)]}"/>
                            <field name="convertible_leave"
                                attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('absence', '!=', False)]}"/>
                            <field name="converted" readonly="1" force_save="1"/>
                            <field name="payslip_id" readonly="1" force_save="1"
                                attrs="{'invisible': [('converted', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="notes" string="Notes" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('absence', '!=', False)]}"/>
                        </group>
                        <group>
                            <field name="leave_count" attrs="{'invisible': [('absence', '!=', False)]}"/>
                            <field name="leave_balance" attrs="{'invisible': [('absence', '!=', False)]}"/>
                        </group>
                    </group>
                    <group string="Leave Requests" attrs="{'invisible': [('absence', '!=', False)]}">
                        <field name="leave_ids" nolabel="1" colspan="4" readonly="1"
                            attrs="{'invisible': [('absence', '!=', False)]}">
                            <tree string="">
                                <field name="notes" string="Notes/Remarks"/>
                                <field name="request_date_from"/>
                                <field name="request_date_to"/>
                                <field name="number_of_days"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_leave_allocation" model="ir.actions.act_window">
        <field name="name">Leave Allocation</field>
        <field name="res_model">hr.leave.allocation</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="leave_allocation_action_tree_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">tree</field>
        <field name="act_window_id" ref="action_leave_allocation"/>
        <field name="view_id" ref="leave_allocation_inherit_tree"/>
    </record>
    <record id="leave_allocation_action_form_view" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="act_window_id" ref="action_leave_allocation"/>
        <field name="view_id" ref="leave_allocation_form"/>
    </record>

    <record id="action_leave_allocation_employee" model="ir.actions.act_window">
        <field name="name">Leave Allocation</field>
        <field name="res_model">hr.leave.allocation</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', 'in', ('draft', 'confirm', 'validate'))]</field>
    </record>

    <record id="employee_leave_alloc_form" model="ir.ui.view">
        <field name="name">hr.employee.leave.alloc</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_leave_allocation_employee)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-clipboard"
                    context="{'search_default_employee_id': active_id, 'default_employee_id': active_id}">
                    <field name="leave_allocation" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>


    <!-- LEAVE REQUESTS -->
    <record model="ir.ui.view" id="leave_request_inherit_form">
        <field name="name">leave.request.inherit.form</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <button name="action_validate" position="replace"/>
            <button name="action_refuse" position="replace"/>

            <button name="action_approve" position="replace">
                <button string="Approve" name="action_approve" type="object" states="for_approval" class="oe_highlight"
                    groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user"/>
                <button string="Cancel" name="action_cancel" states="confirm,for_approval" type="object"
                    confirm="You are about to cancel this request. Press Ok to continue"
                    groups="hr_holidays.group_hr_holidays_manager"/>
            </button>
            <button name="action_draft" position="replace">
                <button string="Set to Draft" name="action_draft" states="confirm,for_approval,approve" type="object"
                    groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user"/>
            </button>

            <button name="action_confirm" position="after">
                <button string="Recommending Approval" name="action_for_approval" states="confirm" type="object" class="oe_highlight" groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user"/>
            </button>

            <field name="state" position="replace">
                <field name="state" widget="statusbar"/>
            </field>

            <field name="employee_id" position="attributes">
                <attribute name="domain">[('id', '&gt;', 1)]</attribute>
                <attribute name="force_save">1</attribute>
                <attribute name="attrs">{'readonly': [('state', 'not in', ('draft', 'confirm'))]}</attribute>
            </field>

            <field name="holiday_status_id" position="replace">
                <field name="employee_id" required="1" force_save="1" domain="[('id', '&gt;', 1)]" attrs="{'readonly': [('state', 'not in', ('draft', 'confirm'))]}"/>
                <field name="contract_id" readonly="1" force_save="1"/>
                <field name="absence" attrs="{'readonly': [('state', 'not in', ('draft', 'confirm'))]}"/>
                <field name="leave_allocation_id"
                    domain="[('employee_id', '=', employee_id), ('state', '=', 'validate'), ('leave_balance', '&gt;', 0)]"
                    attrs="{'readonly': [('state', 'not in', ('draft', 'confirm'))], 'required':[('absence', '=', False)], 'invisible': [('absence', '!=', False)]}"/>
                <field name="holiday_status_id" readonly="1" force_save="1"/>
                <label for="leave_balance" attrs="{'invisible': [('absence', '!=', False)]}"/>
                <div attrs="{'invisible': [('absence', '!=', False)]}">
                    <field name="leave_balance" nolabel="1" readonly="1" force_save="1" class="oe_inline"/>
                    <span class="ml8">Days</span>
                </div>
            </field>
            <field name="request_date_from" position="attributes">
                <attribute name="required">1</attribute>
            </field>

            <field name="request_date_to" position="attributes">
                <attribute name="attrs">{'readonly': [('state', 'not in', ('draft', 'confirm'))], 'invisible': ['|', ('request_unit_half', '=', True), ('request_unit_hours', '=', True)], 'required': [('request_unit_half', '=', False)]}</attribute>
            </field>
            <field name="request_date_from_period" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="name" position="replace"/>
            <xpath expr="//group/group[1]" position="after">
                <group>
                    <field name="leave_date_ids" required="1" readonly="1" force_save="1">
                        <tree string="">
                            <field name="date"/>
                            <field name="payroll_period_id"/>
                        </tree>
                    </field>
                </group>
                <group colspan="4">
                    <field name="notes" string="Notes/Remarks" required="1" colspan="4"/>
                </group>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="hr_holidays.hr_leave_view_form_manager">
        <field name="name">leave.request.manager.form</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='col_right']" position="replace"/>
        </field>
    </record>

    <record id="emp_own_leave_inherit_form" model="ir.ui.view">
        <field name="name">emp.own.leave.inherit.form</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="groups_id" eval="[(4, ref('grp_emp_own_leave'))]"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="contract_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="leave_allocation_id" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
            </field>
            <field name="leave_date_ids" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="leave_request_new_tree">
        <field name="name">leave.request.new.tree</field>
        <field name="model">hr.leave</field>
        <field name="mode">primary</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree string="Leave Requests"
                decoration-primary="state=='draft'"
                decoration-info="state=='confirm'"
                decoration-success="state=='for_approval'"
                decoration-muted="state=='cancel'">
                <field name="employee_id"/>
                <field name="leave_allocation_id"/>
                <field name="holiday_status_id"/>
                <field name="notes" string="Notes/Remarks"/>
                <field name="request_date_from"/>
                <field name="request_date_to"/>
                <field name="number_of_days"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="emp_own_leave_inherit_tree" model="ir.ui.view">
        <field name="name">emp.own.leave.inherit.tree</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="leave_request_new_tree"/>
        <field name="groups_id" eval="[(4, ref('grp_emp_own_leave'))]"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="import">false</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="hr_holidays_inherit_search">
        <field name="name">hr.holidays.inherit.search</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='approve']" position="attributes">
                <attribute name="domain">[('state', 'in', ('confirm', 'for_approval'))]</attribute>
            </xpath>
            <xpath expr="//filter[@name='validated']" position="attributes">
                <attribute name="domain">[('state', '=', 'approve')]</attribute>
            </xpath>
            <filter name="active_types" position="replace"/>
            <filter name="message_needaction" position="replace"/>
            <filter name="department" position="replace"/>
            <filter name="my_team_leaves" position="replace"/>
            <filter name="gray" position="replace"/>
            <filter name="todo" position="replace"/>
            <xpath expr="//filter[@name='year']" position="attributes">
                <attribute name="domain">[('request_date_from','&lt;=', time.strftime('%%Y-12-31')),('request_date_from','&gt;=',time.strftime('%%Y-01-01')),('request_date_to','&lt;=', time.strftime('%%Y-12-31')),('request_date_to','&gt;=',time.strftime('%%Y-01-01'))]</attribute>
                <attribute name="string">This Year</attribute>
            </xpath>
            <filter name="group_name" position="replace"/>
            <filter name="group_category" position="replace"/>
            <filter name="group_manager" position="replace"/>
            <filter name="group_second_approver_id" position="replace"/>
            <xpath expr="//filter[@name='group_type']" position="attributes">
                <attribute name="string">Leave Type</attribute>
            </xpath>
            <xpath expr="//filter[@name='group_type']" position="before">
                <filter name="group_allocation" string="Leave Allocation" context="{'group_by': 'leave_allocation_id'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </xpath>
        </field>
    </record>

    <delete model="ir.ui.menu" id="hr_holidays.menu_hr_holidays_my_leaves"/>
    <delete model="ir.ui.menu" id="hr_holidays.hr_leave_menu_new_request"/>
    <delete model="ir.ui.menu" id="hr_holidays.menu_open_company_allocation"/>
    <delete model="ir.ui.menu" id="hr_holidays.menu_hr_holidays_approvals"/>
    <delete model="ir.ui.menu" id="hr_holidays.hr_holidays_menu_manager_approve"/>
    <delete model="ir.ui.menu" id="hr_holidays.hr_holidays_menu_manager_all"/>
    <delete model="ir.ui.menu" id="hr_holidays.hr_holidays_menu_manager_payroll"/>
    <delete model="ir.ui.menu" id="hr_holidays.menu_open_department_leave_approve"/>
    <delete model="ir.ui.menu" id="hr_holidays.hr_holidays_menu_manager_payroll_to_report"/>
    <delete model="ir.ui.menu" id="hr_holidays.hr_holidays_menu_manager_approve_allocations"/>
    <delete model="ir.ui.menu" id="hr_holidays.hr_holidays_menu_manager_all_allocations"/>
    <delete model="ir.ui.menu" id="hr_holidays.menu_open_employee_leave"/>
    
    <record id="action_leave_request_list" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.leave</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
    </record>
    <record id="leave_request_tree" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">tree</field>
        <field name="act_window_id" ref="action_leave_request_list"/>
        <field name="view_id" ref="leave_request_new_tree"/>
    </record>
    <record id="leave_request_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="act_window_id" ref="action_leave_request_list"/>
        <field name="view_id" ref="hr_holidays.hr_leave_view_form"/>
    </record>

    <menuitem id="hr_holidays.hr_leave_menu_my"
        parent="hr_holidays.menu_hr_holidays_root"
        action="action_leave_request_list"
        sequence="2"
        groups="hr_holidays.group_hr_holidays_manager"/>

    <menuitem id="menu_leave_allocations_main"
        name="Leave Allocations"
        parent="hr_holidays.menu_hr_holidays_root"
        sequence="3"
        groups="hr_holidays.group_hr_holidays_manager"/>
    
    <menuitem id="hr_holidays.menu_open_allocation"
        parent="menu_leave_allocations_main"
        action="action_leave_allocation"
        sequence="1"
        groups="hr_holidays.group_hr_holidays_manager"/>


    <record id="hr_holidays.view_employee_form_leave_inherit" model="ir.ui.view">
        <field name="name">hr.employee.leave.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="active" eval="False"/>
    </record>


    <!-- Multiple Leave Allocation -->
    <record model="ir.ui.view" id="leave_alloc_multiple_form">
        <field name="name">leave.alloc.multiple.form</field>
        <field name="model">leave.allocation.multiple</field>
        <field name="arch" type="xml">
            <form string="Multiple Leave Allocation">
                <header>
                    <button type="object" name="create_allocation" string="Create Allocation" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="fiscal_year_id"/>
                            <field name="leave_type_id" domain="[('absence', '=', False)]"/>
                            <field name="number_of_days"/>
                            <field name="convertible_leave"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Employees">
                        <field name="employee_ids" nolabel="1" colspan="4" domain="[('id', '&gt;', 1)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_leave_alloc_multiple" model="ir.actions.act_window">
