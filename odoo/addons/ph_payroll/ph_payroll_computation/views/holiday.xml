<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="holiday_form_view" model="ir.ui.view">
        <field name="name">holiday.form.view</field>
        <field name="model">hr.holiday</field>
        <field name="arch" type="xml">
            <form string="Holidays">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Holiday Name :" style="font-weight: bold"/>
                        <h1><field name="name" readonly="0" force_save="1" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="holiday_type"/>
                            <field name="date"/>
                            <field name="double_holiday"/>
                        </group>
                        <group>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Exempted Employees" attrs="{'invisible': [('holiday_type', '=', 'special')]}">
                            <field name="exempted_emp_ids" colspan="4" nolabel="1"
                                options="{'no_create': True}" domain="[('id', '&gt;', 1)]"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="holiday_tree_view" model="ir.ui.view">
        <field name="name">holiday.tree.view</field>
        <field name="model">hr.holiday</field>
        <field name="arch" type="xml">
            <tree string="Holidays">
                <field name="name"/>
                <field name="holiday_type"/>
                <field name="date"/>
                <field name="double_holiday"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="holiday_calendar_view" model="ir.ui.view">
        <field name="name">holiday.calendar.view</field>
        <field name="model">hr.holiday</field>
        <field name="arch" type="xml">
            <calendar string="Holidays" date_start="date" date_stop="date"
                mode="month" quick_add="False">
                <field name="name"/>
                <field name="holiday_type"/>
           </calendar>
        </field>
    </record>

    <record id="holiday_search_view" model="ir.ui.view">
        <field name="name">holiday.search.view</field>
        <field name="model">hr.holiday</field>
        <field name="arch" type="xml">
            <search string="Holidays">
                <field name="name"/>
                <field name="date"/>
                <field name="note"/>
                <group string="Group By">
                    <filter string="Type" name="grp_type" context="{'group_by': 'holiday_type'}"/>
                    <filter string="Date" name="grp_date" context="{'group_by': 'date'}"/>
                    <filter string="Current Year" name="current_year"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-01-01')), ('date', '&lt;=', context_today().strftime('%Y-12-31'))]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </group>
           </search>
        </field>
    </record>

    <record id="action_holiday" model="ir.actions.act_window">
        <field name="name">Holidays</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.holiday</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,calendar,form</field>
        <field name="context">{'search_default_current_year': 1}</field>
    </record>

    <menuitem id="menu_holiday"
        action="action_holiday"
        parent="hr_payroll.menu_hr_payroll_root"
        groups="hr.group_hr_manager,hr.group_hr_user"
        sequence="4"/>

</odoo>