<?xml version="1.0" ?>
<odoo>
    <data noupdate="1">

        <record id="ir_seq_hr_loan" model="ir.sequence">
            <field name="name">Loan Request</field>
            <field name="code">hr.loan.seq</field>
            <field name="prefix">LO/</field>
            <field name="padding">10</field>
            <field name="number_increment">1</field>
            <field name="number_next_actual">1</field>
            <field name="implementation">standard</field>
        </record>

        <record id="ir_seq_hr_canteen" model="ir.sequence">
            <field name="name">Canteen Charges</field>
            <field name="code">hr.canteen.seq</field>
            <field name="prefix">CL/</field>
            <field name="padding">10</field>
            <field name="number_increment">1</field>
            <field name="number_next_actual">1</field>
            <field name="implementation">standard</field>
        </record>

    </data>
</odoo>
