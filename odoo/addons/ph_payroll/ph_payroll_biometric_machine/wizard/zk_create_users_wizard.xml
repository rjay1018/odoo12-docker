<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zk_create_user_view" model="ir.ui.view">
            <field name="name">zk.create.user</field>
            <field name="model">zk.create.user</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <form string="">
                    <group>
                        <field name="machine_id" invisible="0"/>
                        <field name="type"/>
                        <field name="employee_ids" domain="[('id', '&gt;', 1)]"/>
                    </group>
                    <t t-esc="context.get('employees_ids')"/>
                    <footer>
                        <button name="create_users_zk" string="Create" type="object" default_focus="1" class="oe_highlight"/>
                        or 
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>
        
        <act_window
            id="action_create_user_zk"
            name="Create User Zk"
            res_model="zk.create.user"
            src_model="zk.machine.location"
            view_mode="form"
            multi="True"
            target="new"
            key2="client_action_multi"/>

</odoo>