<?xml version="1.0" encoding="UTF-8"?>

<templates>
    <t t-name="MachineAttendanceView.download_attendance">
        <button type="button" class="btn btn-primary o_button_download_attendance">
            Download Attendance
        </button>
        <button type="button" class="btn btn-primary o_button_import_attendance">
            Import Attendance
        </button>
    </t>

    <t t-extend="ListView.buttons" t-name="MachineAttendanceView.buttons">
        <t t-jquery="button.o_list_button_add" t-operation="after">
            <t t-js="ctx">
                if (window.odoo._modules.indexOf("base_import") >= 0) {
                    r.push(context.engine.tools.call(context, 'ImportView.import_button', dict));
                };
            </t>
            <t t-call="MachineAttendanceView.download_attendance"/>
        </t>
    </t>
</templates>