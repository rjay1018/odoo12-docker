<?xml version="1.0"?>
<odoo noupdate="0">

    <record id="cron_download_attendance" model="ir.cron">
        <field name="name">Download Attendance</field>
        <field eval="True" name="active" />
        <field name="user_id" ref="base.user_admin"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="model_id" ref="model_zk_machine" />
        <field name="state">code</field>
        <field name="code">model.cron_download_attendance()</field>
        <field name="nextcall" eval="(datetime.utcnow() + timedelta(days=0)).strftime('%Y-%m-%d 16:00:00')"/>
        <field name="priority">1</field>
    </record>

</odoo>
