<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="assets_backend" name="attendance assets" inherit_id="web.assets_backend">
            <xpath expr="." position="inside">
                <script type="text/javascript" src="/ph_payroll_biometric_machine/static/src/js/machine_attendance.js"/>
            </xpath>
        </template>



        <record id="view_zk_machine_form" model="ir.ui.view">
        <field name="name">zk.machine.form</field>
        <field name="model">zk.machine</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
        <form string="Zk Machine">
            <header>
                <button name="try_connection" type="object" string="Try connection"/>
                <button name="download_attendance2" type="object" string="Test attendance"/>
                <button name="restart" type="object" string="Restart" groups="hr.group_hr_manager"/>
                <button name="synchronize" type="object" string="Synchronize" groups="hr.group_hr_manager"/>
                <button name="%(action_create_user_zk)d" string="Create Users" class="oe_highlight" type="action" context="{'employees_ids':employee_ids}"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
            </header>
            <sheet>
                <div class="oe_left">
                    <h1>
                        <field name="name" required="1" placeholder="Machine IP"/>
                    </h1>
                </div>
                <div class="oe_right oe_button_box">
                    <button name="download_attendance"  string="Download Data" class="oe_stat_button" icon="fa-download " type="object" confirm="Are you sure you want to do this?" />
                    <button name="clear_attendance"  string="Clear attendance" class="oe_stat_button" icon="fa-trash-o " type="object" confirm="Are you sure you want to delete the registered attendance in the zkteco device?" />
                </div>
                <br/><br/><br/>
                <group col="4"  colspan="4"> 
                    <field name="port" required="1"/>
                    <field name="location_id" required="1"/>
                    <field name="id" invisible="1"/>
                </group>
                <notebook >
                    <page string="Employees">
                        <field name="employee_ids" context="{'machine_id':id}" domain="[('id', '&gt;', 1)]">
                            <tree>
                                <field name="name"/>
                                <field name="identification_id"/>
                                <button name="delete_employee_zk" type="object" icon="fa-times-circle" groups="hr.group_hr_manager" context="{'machine_id':parent.id}" confirm="Surely you want to delete the employee of the zkteco device?" help="Delete employee of zkteco device."/>
                                <button name="disassociate_employee_zk" type="object" icon="fa-chain-broken" groups="hr.group_hr_manager" context="{'machine_id':parent.id}" confirm="Are you sure you want to unlink the zkteco user from your system?" help="Unlink a zkteco user from the device created on his odoo system."/>
                            </tree>
                        </field>
                    </page> 
                </notebook>
                
            </sheet>
        </form>
        </field>
    </record>

    <record id="view_zk_machine_tree" model="ir.ui.view">
        <field name="name">zk.machine.tree</field>
        <field name="model">zk.machine</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="Zk Machine">
                <field name="name"/>
                <field name="location_id"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_employee_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <data>
                <page name="hr_settings" position="after">
                    <page string="ZK Number &amp; Location">
                        <field name="zk_location_line_ids">
                            <tree create="0" delete="0" edit="0">
                                <field name="machine_id"/>
                                <field name="zk_num"/>
                                <field name="employee_id" invisible="1"/>
                            </tree>
                            <form create="0" delete="0" edit="0">
                                <group>
                                    <field name="machine_id"/>
                                    <field name="zk_num"/>
                                </group>
                            </form>
                        </field>
                    </page>
                 </page>
            </data>
        </field>
    </record>

    <record model="ir.ui.view" id="hr_employee_barcode_inherit_form">
        <field name="name">hr.employee.barcode.inherit.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_attendance.view_employee_form_inherit_hr_attendance"/>
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <field name="zknumber"/>
            </field>
        </field>
    </record>
    
    <record id="attendance_machine_action" model="ir.actions.act_window">
        <field name="name">Biometric Machines</field>
        <field name="res_model">zk.machine</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>


    <menuitem id="attendance_machine_menu"
        action="attendance_machine_action"
        parent="hr_attendance.menu_hr_attendance_manage_attendances"
        sequence="30"/>
    
    
    <record id="view_attendance_tree_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <data>
                 <tree position="attributes">
                    <attribute name="decoration-danger">check_in==False or check_out==False</attribute>
                    <attribute name="decoration-success">check_in!=False and check_out!=False</attribute>
                 </tree>
            </data>
        </field>
    </record>


    <!-- Attendance Logs -->
    <record id="view_machine_attendance_tree" model="ir.ui.view">
        <field name="name">zk.machine.attendance.tree</field>
        <field name="model">zk.machine.attendance</field>
        <field name="arch" type="xml">
            <tree string="Biometric Attendance Logs" js_class="machine_attendance_tree">
                <field name="employee_id"/>
                <field name="zknumber"/>
                <field name="punch_type"/>
                <field name="punch_time"/>
                <field name="import_done"/>
            </tree>
        </field>
    </record>

    <record id="view_machine_attendance_form" model="ir.ui.view">
        <field name="name">zk.machine.attendance.form</field>
        <field name="model">zk.machine.attendance</field>
        <field name="arch" type="xml">
            <form string="Biometric Attendance Logs">
                <group>
                    <group>
                        <field name="employee_id" options="{'no_create': True}" domain="[('id', '&gt;', 1)]"/>
                        <field name="zknumber"/>
                        <field name="punch_type"/>
                        <field name="punch_time"/>
                        <field name="import_done"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="view_machine_attendance_search" model="ir.ui.view">
        <field name="name">zk.machine.attendance.search</field>
        <field name="model">zk.machine.attendance</field>
        <field name="arch" type="xml">
            <search string="Biometric Attendance Logs">
                <field name="employee_id" string="Employee Name or ZK number"
                    filter_domain="['|', ('employee_id', 'ilike', self), ('zknumber', 'ilike', self)]"/>
                <field name="punch_type"/>
                <field name="punch_time"/>
                <filter name="grp_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="grp_punch_time" string="Punch Time" context="{'group_by': 'punch_time:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_machine_attendance" model="ir.actions.act_window">
        <field name="name">Biometric Attendance Logs</field>
        <field name="res_model">zk.machine.attendance</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_grp_employee': 1}</field>
    </record>

    <menuitem id="menu_machine_attendance"
        action="action_machine_attendance"
        parent="hr_attendance.menu_hr_attendance_manage_attendances"
        sequence="31"/>

    </data>
</odoo>
